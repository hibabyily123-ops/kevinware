-- SORU MACROS  (rebuilt from the Kevin's Taco Shop v5 values)
--========================================================================
local Soru = {
	on = false,
	detect = true,
	onKey = true,
	pressKey = Enum.KeyCode.X,
	delay = 50,
	rspam = false,
	rgap = 30,
	soruKey = nil, -- nil = auto
	last = 0,
	conns = {},
	rBusy = false,
}

do
	local VIM = game:GetService("VirtualInputManager")

	local function typing()
		return UserInputService:GetFocusedTextBox() ~= nil
	end

	local function tap(key)
		pcall(function()
			VIM:SendKeyEvent(true, key, false, game)
			task.wait(0.02)
			VIM:SendKeyEvent(false, key, false, game)
		end)
	end

	-- best-effort: find the key shown next to the Soru ability in the game UI, else Q
	local autoCache, autoStamp = nil, 0
	function Soru.autoKey()
		if autoCache and os.clock() - autoStamp < 5 then
			return autoCache
		end
		local found
		pcall(function()
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if not pg then
				return
			end
			for _, d in ipairs(pg:GetDescendants()) do
				if d:IsA("TextLabel") or d:IsA("TextButton") then
					if string.lower(d.Text) == "soru" or string.lower(d.Name) == "soru" then
						local scope = d.Parent
						if scope then
							for _, t in ipairs(scope:GetDescendants()) do
								if (t:IsA("TextLabel") or t:IsA("TextButton")) and #t.Text == 1 then
									local k = Enum.KeyCode[string.upper(t.Text)]
									if k then
										found = k
										return
									end
								end
							end
						end
					end
				end
			end
		end)
		autoCache = found or Enum.KeyCode.Q
		autoStamp = os.clock()
		return autoCache
	end

	function Soru.currentKey()
		return Soru.soruKey or Soru.autoKey()
	end

	function Soru.trigger()
		if not Soru.on then
			return
		end
		local now = os.clock()
		if now - Soru.last < 0.6 then
			return
		end
		Soru.last = now
		task.delay(Soru.delay / 1000, function()
			if Soru.on then
				tap(Soru.pressKey)
			end
		end)
	end

	local function clearConns()
		for _, c in ipairs(Soru.conns) do
			c:Disconnect()
		end
		Soru.conns = {}
	end

	local function hookCharacter(char)
		clearConns()
		task.spawn(function()
			local hum = char:WaitForChild("Humanoid", 8)
			local animator = hum and (hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5))
			if animator then
				table.insert(
					Soru.conns,
					animator.AnimationPlayed:Connect(function(track)
						if not Soru.detect then
							return
						end
						local n = string.lower((track.Animation and track.Animation.Name or "") .. " " .. track.Name)
						if string.find(n, "flashstep", 1, true) then
							Soru.trigger()
						end
					end)
				)
			end
			local function hookSound(snd)
				if snd:IsA("Sound") then
					local n = string.lower(snd.Name)
					if string.find(n, "flashstep", 1, true) or string.find(n, "soru", 1, true) then
						table.insert(
							Soru.conns,
							snd.Played:Connect(function()
								if Soru.detect then
									Soru.trigger()
								end
							end)
						)
					end
				end
			end
			for _, d in ipairs(char:GetDescendants()) do
				hookSound(d)
			end
			table.insert(Soru.conns, char.DescendantAdded:Connect(hookSound))
		end)
	end
	if LocalPlayer.Character then
		hookCharacter(LocalPlayer.Character)
	end
	bindConn(LocalPlayer.CharacterAdded, hookCharacter)
	onUnload(clearConns)

	bindConn(UserInputService.InputBegan, function(input)
		if not Soru.on or typing() then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		if Soru.onKey and input.KeyCode == Soru.currentKey() then
			Soru.trigger()
		end
		if Soru.rspam and input.KeyCode == Enum.KeyCode.R and not Soru.rBusy then
			Soru.rBusy = true
			task.spawn(function()
				while Soru.on and Soru.rspam and UserInputService:IsKeyDown(Enum.KeyCode.R) and not typing() do
					tap(Enum.KeyCode.R)
					task.wait(Soru.rgap / 1000)
				end
				Soru.rBusy = false
			end)
		end
	end)
end

