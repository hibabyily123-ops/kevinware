-- fn(values, instant) is called now and on every change
function Theme.bind(fn)
	table.insert(Theme.listeners, fn)
	fn(Theme.values, true)
	return fn
end

function Theme.apply(patch, instant)
	for k, v in pairs(patch) do
		Theme.values[k] = v
	end
	computeDerived(Theme.values)
	for _, fn in ipairs(Theme.listeners) do
		pcall(fn, Theme.values, instant)
	end
end

function Theme.setPreset(name)
	for _, p in ipairs(PRESETS) do
		if p.name == name then
			local patch = { preset = name }
			for k, v in pairs(p) do
				if k ~= "name" then
					patch[k] = v
				end
			end
			Theme.apply(patch)
			return
		end
	end
end

--========================================================================
-- ICONS (drawn from frames, strokes and rounded lines; 24x24 design grid)
--========================================================================
local function buildIcon(kind, size, parent, color, thickness)
	local s = size / 24
	local TH = thickness or 2
	local holder = new("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
	}, parent)

	local parts = {}
	local function reg(obj, prop)
		table.insert(parts, { obj, prop })
	end

	local function line(x1, y1, x2, y2)
		local dx, dy = (x2 - x1) * s, (y2 - y1) * s
		local len = math.sqrt(dx * dx + dy * dy)
		local props = {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2 * s, (y1 + y2) / 2 * s),
			BackgroundColor3 = color,
		}
		if dy == 0 then
			props.Size = UDim2.fromOffset(len + TH, TH)
		elseif dx == 0 then
			props.Size = UDim2.fromOffset(TH, len + TH)
		else
			props.Size = UDim2.fromOffset(len + TH, TH)
			props.Rotation = math.deg(math.atan2(dy, dx))
		end
		local f = frame(props, holder)
		corner(f, 99)
		reg(f, "BackgroundColor3")
	end

	local function ring(cx, cy, r)
		local d = math.max(r * 2 * s - TH, 1)
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * s, cy * s),
			Size = UDim2.fromOffset(d, d),
			BackgroundTransparency = 1,
		}, holder)
		corner(f, 999)
		reg(stroke(f, 0, color, TH), "Color")
	end

	local function dot(cx, cy, d)
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * s, cy * s),
			Size = UDim2.fromOffset(d * s, d * s),
			BackgroundColor3 = color,
		}, holder)
		corner(f, 999)
		reg(f, "BackgroundColor3")
	end

	local function pill(cx, cy, w, h)
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * s, cy * s),
			Size = UDim2.fromOffset(w * s, h * s),
			BackgroundColor3 = color,
		}, holder)
		corner(f, 999)
		reg(f, "BackgroundColor3")
	end

	local function box(cx, cy, w, h, r)
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * s, cy * s),
			Size = UDim2.fromOffset(math.max(w * s - TH, 1), math.max(h * s - TH, 1)),
			BackgroundTransparency = 1,
		}, holder)
		corner(f, r * s)
		reg(stroke(f, 0, color, TH), "Color")
	end

	local function seg(x1, x2, y)
		if x2 - x1 >= 0.01 then
			line(x1, y, x2, y)
		end
	end

	if kind == "aim" then
		ring(12, 12, 9)
		line(12, 3, 12, 7)
		line(12, 21, 12, 17)
		line(3, 12, 7, 12)
		line(21, 12, 17, 12)
		dot(12, 12, 3)
	elseif kind == "movement" then
		line(4, 6, 10, 12)
		line(10, 12, 4, 18)
		line(13, 6, 19, 12)
		line(19, 12, 13, 18)
	elseif kind == "esp" then
		line(3, 3, 8, 3)
		line(3, 3, 3, 8)
		line(21, 3, 16, 3)
		line(21, 3, 21, 8)
		line(3, 21, 8, 21)
		line(3, 21, 3, 16)
		line(21, 21, 16, 21)
		line(21, 21, 21, 16)
		dot(12, 9.5, 4.5)
		pill(12, 16.2, 9, 5)
	elseif kind == "macros" then
		box(12, 12, 20, 14, 3.5)
		dot(7.5, 10, 2.2)
		dot(12, 10, 2.2)
		dot(16.5, 10, 2.2)
		line(8.5, 14.5, 15.5, 14.5)
	elseif kind == "environment" then
		ring(12, 12, 4.2)
		line(12, 2.5, 12, 5)
		line(12, 19, 12, 21.5)
		line(2.5, 12, 5, 12)
		line(19, 12, 21.5, 12)
		line(5.3, 5.3, 7, 7)
		line(17, 17, 18.7, 18.7)
		line(18.7, 5.3, 17, 7)
		line(7, 17, 5.3, 18.7)
	elseif kind == "settings" then
		seg(3, 11, 6)
		dot(16, 6, 5)
		seg(13, 21, 12)
		dot(8, 12, 5)
		seg(3, 9, 18)
		seg(19, 21, 18)
		dot(14, 18, 5)
	elseif kind == "cross" then
		line(5, 5, 19, 19)
		line(19, 5, 5, 19)
	elseif kind == "chevron" then
		line(6, 9, 12, 15)
		line(12, 15, 18, 9)
	elseif kind == "check" then
		line(5, 12.5, 10, 17.5)
		line(10, 17.5, 19, 7)
	elseif kind == "k" then
		line(7, 4, 7, 20)
		line(16.5, 4, 8, 12.3)
		line(10.4, 10.4, 17, 20)
	end

	local api = { holder = holder }
	function api.SetColor(c, t)
		for _, p in ipairs(parts) do
			if t and t > 0 then
				tween(p[1], t, { [p[2]] = c })
			else
				p[1][p[2]] = c
			end
		end
	end
	return api
end

-- Kevinware mark: two stacked glass tiles with a bold K, tinted by the accent colour
local function buildLogo(size, parent)
	local holder = new("CanvasGroup", {
		Name = "Logo",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
	}, parent)
	local sc = new("UIScale", { Scale = 1 }, holder)
	local fs = math.floor(size * 0.78)
	local off = size - fs
	local r = math.floor(fs * 0.3)

	local back = frame({
		Position = UDim2.fromOffset(off, off),
		Size = UDim2.fromOffset(fs, fs),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.3,
	}, holder)
	corner(back, r)
	stroke(back, 0.75)
	local backGrad = new("UIGradient", { Rotation = 55 }, back)
	local setBack = gradientSetter(backGrad)

	local front = frame({ Size = UDim2.fromOffset(fs, fs), BackgroundColor3 = C.white }, holder)
	corner(front, r)
	local frontGrad = new("UIGradient", { Rotation = 55 }, front)
	local setFront = gradientSetter(frontGrad)
	local rim = stroke(front, 0, C.white, 1)
	new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 0.85),
		}),
	}, rim)

	Theme.bind(function(v, instant)
		local d = instant and 0 or 0.35
		setFront(lighten(v.accent, 0.18), darken(v.accent, 0.3), d)
		setBack(darken(v.accent, 0.45), darken(v.accent, 0.72), d)
	end)
	buildIcon("k", fs * 0.66, front, C.dark, math.max(2.6, fs * 0.105))
	return holder, sc
end

--========================================================================
-- CONFIG STORE  (every component with a `key` is saved / exported)
--========================================================================
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64REV = {}
for i = 1, 64 do
	B64REV[B64:byte(i)] = i - 1
end

local function b64encode(data)
	local out = {}
	for i = 1, #data, 3 do
		local a, b, c = data:byte(i, i + 2)
		local n = bit32.bor(bit32.lshift(a, 16), bit32.lshift(b or 0, 8), c or 0)
		local c1 = bit32.band(bit32.rshift(n, 18), 63)
		local c2 = bit32.band(bit32.rshift(n, 12), 63)
		local c3 = bit32.band(bit32.rshift(n, 6), 63)
		local c4 = bit32.band(n, 63)
		out[#out + 1] = B64:sub(c1 + 1, c1 + 1)
			.. B64:sub(c2 + 1, c2 + 1)
			.. (b and B64:sub(c3 + 1, c3 + 1) or "=")
			.. (c and B64:sub(c4 + 1, c4 + 1) or "=")
	end
	return table.concat(out)
end

local function b64decode(s)
	s = s:gsub("[^%w%+/=]", "")
	local out = {}
	for i = 1, #s, 4 do
		local c1, c2, c3, c4 = s:byte(i, i + 3)
		local n1, n2 = B64REV[c1], B64REV[c2]
		local n3 = (c3 and c3 ~= 61) and B64REV[c3] or nil
		local n4 = (c4 and c4 ~= 61) and B64REV[c4] or nil
		local n = bit32.bor(bit32.lshift(n1, 18), bit32.lshift(n2, 12), bit32.lshift(n3 or 0, 6), n4 or 0)
		out[#out + 1] = string.char(bit32.band(bit32.rshift(n, 16), 255))
		if n3 then
			out[#out + 1] = string.char(bit32.band(bit32.rshift(n, 8), 255))
		end
		if n4 then
			out[#out + 1] = string.char(bit32.band(n, 255))
		end
	end
	return table.concat(out)
end

local function toHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function fromHex(h)
	local r = tonumber(h:sub(2, 3), 16)
	local g = tonumber(h:sub(4, 5), 16)
	local b = tonumber(h:sub(6, 7), 16)
	if not (r and g and b) then
		return nil
	end
	return Color3.fromRGB(r, g, b)
end

local Cfg = { items = {}, order = {}, auto = false, suppress = false, stamp = 0, file = "Kevinware/config.txt" }

function Cfg.add(key, get, set, opts)
	opts = opts or {}
	local ok, def = pcall(get)
	Cfg.items[key] = {
		get = get,
		set = set,
		default = ok and def or nil,
		noReset = opts.noReset,
		skip = opts.skip,
		noExport = opts.noExport,
	}
	table.insert(Cfg.order, key)
end

function Cfg.canFile()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

function Cfg.snapshot()
	local d = {}
	for _, key in ipairs(Cfg.order) do
		local it = Cfg.items[key]
		if not it.noExport and not (it.skip and it.skip()) then
			local ok, v = pcall(it.get)
			if ok and v ~= nil and v ~= it.default then
				d[key] = v
			end
		end
	end
	return { v = 1, auto = Cfg.auto, d = d }
end

function Cfg.encode()
	return "KW1:" .. b64encode(game:GetService("HttpService"):JSONEncode(Cfg.snapshot()))
end

function Cfg.decode(code)
	code = tostring(code or ""):gsub("%s+", "")
	if code:sub(1, 4) ~= "KW1:" then
		return nil
	end
	local ok, data = pcall(function()
		return game:GetService("HttpService"):JSONDecode(b64decode(code:sub(5)))
	end)
	if ok and type(data) == "table" and type(data.d) == "table" then
		return data
	end
	return nil
end

-- applies a decoded config; keys missing from it go back to their default
function Cfg.apply(data)
	Cfg.suppress = true
	local n = 0
	for _, key in ipairs(Cfg.order) do
		local it = Cfg.items[key]
		local v = data.d[key]
		if v ~= nil then
			if pcall(it.set, v) then
				n += 1
			end
		elseif not it.noReset and it.default ~= nil then
			pcall(it.set, it.default)
		end
	end
	Cfg.suppress = false
	return n
end

function Cfg.saveFile()
	if not Cfg.canFile() then
		return false
	end
	pcall(function()
		if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("Kevinware") then
			makefolder("Kevinware")
		end
	end)
	return (pcall(writefile, Cfg.file, Cfg.encode()))
end

function Cfg.loadFile()
	if not Cfg.canFile() then
		return nil
	end
	local ok, exists = pcall(isfile, Cfg.file)
	if not (ok and exists) then
		return nil
	end
	local ok2, txt = pcall(readfile, Cfg.file)
	if not ok2 then
		return nil
	end
	return Cfg.decode(txt)
end

-- debounced autosave
function Cfg.dirty()
	if Cfg.suppress or not Cfg.auto then
		return
	end
	Cfg.stamp += 1
	local s = Cfg.stamp
	task.delay(1.2, function()
		if s == Cfg.stamp and Cfg.auto and not unloaded then
			Cfg.saveFile()
		end
	end)
end

function Cfg.copy(text)
	local fn = (type(setclipboard) == "function" and setclipboard)
		or (type(toclipboard) == "function" and toclipboard)
		or (type(set_clipboard) == "function" and set_clipboard)
	if not fn then
		return false
	end
	return (pcall(fn, text))
end

