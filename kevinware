local function makeButton(parent, text, style, w, h, extra)
	local props = {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		ZIndex = 3,
	}
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	local b = new("TextButton", props, parent)
	corner(b, h / 2)
	local st = stroke(b, 0.9)
	local txt = label({
		Text = text,
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Enum.Font.GothamSemibold,
		TextSize = 13,
	}, b)
	local sc = new("UIScale", { Scale = 1 }, b)
	local obj = { Button = b, style = style }
	local BASE = { primary = 0, ghost = 0.88, danger = 0.82 }

	local function paint(v, instant)
		local d = instant and 0 or 0.25
		if obj.style == "primary" then
			setProps(b, d, { BackgroundColor3 = v.accent, BackgroundTransparency = 0 })
			setProps(txt, d, { TextColor3 = v.onAccent })
			st.Transparency = 1
		elseif obj.style == "danger" then
			setProps(b, d, { BackgroundColor3 = C.danger, BackgroundTransparency = 0.82 })
			setProps(txt, d, { TextColor3 = C.danger })
			st.Color = C.danger
			st.Transparency = 0.65
		else
			setProps(b, d, { BackgroundColor3 = C.white, BackgroundTransparency = 0.88 })
			setProps(txt, d, { TextColor3 = C.white })
			st.Color = C.white
			st.Transparency = 0.9
		end
	end
	Theme.bind(paint)

	b.MouseEnter:Connect(function()
		tween(b, 0.15, { BackgroundTransparency = math.max(0, BASE[obj.style] - 0.1) })
		tween(sc, 0.2, { Scale = 1.03 })
	end)
	b.MouseLeave:Connect(function()
		tween(b, 0.2, { BackgroundTransparency = BASE[obj.style] })
