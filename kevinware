	}, r)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 10),
		VerticalAlignment = Enum.VerticalAlignment.Center,
	}, row)

	local selected = o.default
	local chips = {}
	local function render()
		nameLabel.Text = selected or "Custom"
		for name, c in pairs(chips) do
			local on = name == selected
			tween(c.ring, 0.25, { Transparency = on and 0 or 1 })
			tween(c.scale, 0.35, { Scale = on and 1 or 0.9 }, Enum.EasingStyle.Back)
		end
	end
	for _, item in ipairs(o.items) do
		local b = new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(38, 38),
		}, row)
		local sc = new("UIScale", { Scale = 0.9 }, b)
		local ringF = frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, b)
		corner(ringF, 19)
		local ring = stroke(ringF, 1, C.white, 2)
		local inner = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = C.white,
		}, b)
		corner(inner, 14)
		new("UIGradient", { Rotation = 45, Color = ColorSequence.new(item.color1, item.color2) }, inner)
		chips[item.name] = { ring = ring, scale = sc }
		b.MouseEnter:Connect(function()
			if selected ~= item.name then
				tween(sc, 0.2, { Scale = 1 })
