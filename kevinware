-- TAB SELECTION
--========================================================================
local function setActive(t)
	local prev = active
	active = t
	for _, x in ipairs(TABS) do
		refreshTab(x)
	end
	if t then
		local pos = UDim2.fromOffset(t.x, M.Pad)
		local size = UDim2.fromOffset(t.w, M.TabH)
		if prev then
			tween(indicator, 0.4, { Position = pos, Size = size })
		else
			indicator.Position = pos
			indicator.Size = size
		end
		tween(indicator, 0.25, { BackgroundTransparency = indicatorAlpha })
		tween(indicatorStroke, 0.25, { Transparency = 0 })
		showPanel(t, prev ~= nil)
	else
		tween(indicator, 0.2, { BackgroundTransparency = 1 })
		tween(indicatorStroke, 0.2, { Transparency = 1 })
		hidePanel()
	end
end

