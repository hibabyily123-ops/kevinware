local minToken = 0
local function setMinimized(m)
	if m == state.minimized then
		return
	end
	state.minimized = m
	minToken += 1
	local token = minToken
	if m then
		if active then
			setActive(nil)
		end
	else
		tabsClip.Visible = true
	end
	tween(barHolder, 0.55, { Size = UDim2.fromOffset(barWidth(m), M.BarH) })
	tween(tabsClip, 0.55, {
		Size = UDim2.fromOffset(m and 0 or tabsWidth, M.BarH),
		GroupTransparency = m and 1 or 0,
	})
	tween(crossGroup, 0.35, { GroupTransparency = m and 1 or 0 })
	tween(crossIcon.holder, 0.55, { Rotation = m and 90 or 0 }, Enum.EasingStyle.Back)
	tween(logoGroup, 0.4, { GroupTransparency = m and 0 or 1 })
	tween(logoScale, 0.55, { Scale = m and 1 or 0.5 }, Enum.EasingStyle.Back)
	if m then
		task.delay(0.56, function()
			if token == minToken and state.minimized then
				tabsClip.Visible = false
			end
		end)
	end
end

crossBtn.MouseButton1Click:Connect(function()
	setMinimized(not state.minimized)
end)

local showToken = 0
local function setShown(v)
	if v == state.shown then
		return
	end
	state.shown = v
	showToken += 1
	local token = showToken
	if v then
		root.Visible = true
		tween(root, 0.65, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	else
		local off = M.HideOffset * math.max(1, uiScaleValue)
		tween(root, 0.45, { Position = UDim2.fromOffset(0, -off) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.46, function()
			if token == showToken and not state.shown then
				root.Visible = false
			end
		end)
	end
	if Snow.refresh then
		Snow.refresh()
	end
end

