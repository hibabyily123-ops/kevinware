	local OPEN_H = 52 + 156
	local header = new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 52),
		ZIndex = 1,
	}, r)
	rowLabel(r, o.text, nil, 0.6)

	local h, s, v = (o.default or C.white):ToHSV()
	local swatch = frame({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0, 26),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = o.default or C.white,
		ZIndex = 2,
	}, r)
	corner(swatch, 15)
	stroke(swatch, 0.6)

	local area = frame({
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 0, 148),
		BackgroundTransparency = 1,
	}, r)

	local sv = frame({
		Position = UDim2.fromOffset(16, 4),
		Size = UDim2.new(1, -32, 0, 104),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
	}, area)
	corner(sv, 10)
	local whiteL = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.white }, sv)
	corner(whiteL, 10)
	new("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
	}, whiteL)
	local blackL = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.black }, sv)
	corner(blackL, 10)
	new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
	}, blackL)
	local svKnob = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		ZIndex = 3,
	}, sv)
	corner(svKnob, 8)
	stroke(svKnob, 0, C.white, 2)

	local hue = frame({
		Position = UDim2.fromOffset(16, 120),
		Size = UDim2.new(1, -32, 0, 14),
		BackgroundColor3 = C.white,
	}, area)
	corner(hue, 7)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, rgb(255, 0, 0)),
			ColorSequenceKeypoint.new(1 / 6, rgb(255, 255, 0)),
			ColorSequenceKeypoint.new(2 / 6, rgb(0, 255, 0)),
			ColorSequenceKeypoint.new(3 / 6, rgb(0, 255, 255)),
			ColorSequenceKeypoint.new(4 / 6, rgb(0, 0, 255)),
			ColorSequenceKeypoint.new(5 / 6, rgb(255, 0, 255)),
			ColorSequenceKeypoint.new(1, rgb(255, 0, 0)),
		}),
	}, hue)
	local hueKnob = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = C.white,
		ZIndex = 3,
	}, hue)
	corner(hueKnob, 9)
	stroke(hueKnob, 0.6, C.black, 1)

	local function apply(fire)
		local c = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = c
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svKnob.Position = UDim2.fromScale(s, 1 - v)
		hueKnob.Position = UDim2.fromScale(h, 0.5)
		if fire and o.callback then
			o.callback(c)
		end
	end
	apply(false)

	local svHit = new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
	}, sv)
	dragArea(svHit, function(x, y)
		s = math.clamp((x - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
		v = 1 - math.clamp((y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
		apply(true)
	end)
	local hueHit = new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, -6),
		ZIndex = 4,
	}, hue)
	dragArea(hueHit, function(x)
