		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = C.white,
		ZIndex = 3,
	}, track)
	corner(knob, 10)

	local on = o.default == true
	local accent = Theme.values.accent
	local function render(animate)
		local d = animate and 0.3 or 0
		if on then
			setProps(track, d, { BackgroundColor3 = accent, BackgroundTransparency = 0 })
			setProps(knob, d, {
				Position = UDim2.new(0, 21, 0.5, 0),
				Size = UDim2.fromOffset(20, 20),
				BackgroundColor3 = luma(accent) > 0.6 and C.dark or C.white,
			}, Enum.EasingStyle.Back)
		else
			setProps(track, d, { BackgroundColor3 = C.white, BackgroundTransparency = 0.82 })
			setProps(knob, d, {
				Position = UDim2.new(0, 3, 0.5, 0),
				Size = UDim2.fromOffset(20, 20),
				BackgroundColor3 = C.white,
			}, Enum.EasingStyle.Back)
		end
	end
	Theme.bind(function(v, instant)
		accent = v.accent
		render(not instant)
	end)

	hit.MouseButton1Down:Connect(function()
		tween(knob, 0.12, {
			Size = UDim2.fromOffset(25, 20),
			Position = on and UDim2.new(0, 16, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		})
	end)
	hit.MouseLeave:Connect(function()
		render(true)
	end)
