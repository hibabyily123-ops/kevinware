				local from = Vector2.new(116, SH)
				if s.tracerOrigin == "Center" then
					from = Vector2.new(116, SH / 2)
				elseif s.tracerOrigin == "Top" then
					from = Vector2.new(116, 0)
				elseif s.tracerOrigin == "Mouse" then
					from = Vector2.new(190, SH * 0.7)
				end
				setL(tracer, from, Vector2.new(116, BY + BH), 1.5)
			else
				tracer.Visible = false
			end
			dot.Visible = s.headDot
			if s.headDot then
				dot.Position = UDim2.fromOffset(116, 62)
				dot.Size = UDim2.fromOffset(8, 8)
				dot.BackgroundColor3 = col
			end
			arrow.Visible = s.arrows
			if s.arrows then
				arrow.BackgroundColor3 = col
			end
		end

		pv.holder, pv.card, pv.sc, pv.st, pv.shadows = holder, card, sc, st, shadows
		pv.draw = draw
		closeB.MouseButton1Click:Connect(function()
			pv.close()
		end)
	end

	function pv.show()
		if not pv.holder then
			build()
		end
		if pv.open then
			return
		end
		pv.open = true
		pv.holder.Visible = true
		pv.sc.Scale = 0.9
		tween(pv.card, 0.4, { GroupTransparency = 0 })
		tween(pv.st, 0.4, { Transparency = 0 })
		tween(pv.sc, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
		for i, l in ipairs(pv.shadows) do
			tween(l, 0.4, { BackgroundTransparency = SHADOW_T[i] })
		end
		pv.conn = RunService.RenderStepped:Connect(function(dt)
			pv.draw(dt)
		end)
	end

	function pv.close()
		if not pv.open then
			return
		end
		pv.open = false
		if pv.conn then
			pv.conn:Disconnect()
			pv.conn = nil
		end
		tween(pv.card, 0.25, { GroupTransparency = 1 })
		tween(pv.st, 0.25, { Transparency = 1 })
		tween(pv.sc, 0.25, { Scale = 0.94 })
		for _, l in ipairs(pv.shadows) do
			tween(l, 0.2, { BackgroundTransparency = 1 })
		end
		task.delay(0.28, function()
			if not pv.open then
				pv.holder.Visible = false
			end
		end)
	end
	onUnload(function()
		if pv.conn then
			pv.conn:Disconnect()
		end
	end)
	ESP.preview = pv
end

