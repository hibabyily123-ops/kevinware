		end
	end

	local function setChams(o, on, char, col)
		if on then
			if not o.hl or not o.hl.Parent then
				o.hl = Instance.new("Highlight")
				o.hl.Name = "KevinwareChams"
				o.hl.Parent = gui
			end
			local h, s = o.hl, ESP.s
			h.Adornee = char
			h.FillColor = col
			h.OutlineColor = col
			h.FillTransparency = s.chamsFill
			h.OutlineTransparency = 0.1
			h.DepthMode = s.chamsThrough and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
			h.Enabled = true
		elseif o.hl then
			o.hl:Destroy()
			o.hl = nil
		end
	end

	local function hideDetails(o)
		o.box.Visible = false
		for i = 1, 8 do
			o.corners[i].Visible = false
		end
		o.name.Visible, o.dist.Visible, o.tool.Visible, o.hpText.Visible = false, false, false, false
		o.hpBg.Visible, o.hpFill.Visible, o.dot.Visible = false, false, false
		for i = 1, #o.skel do
			o.skel[i].Visible = false
		end
	end

	local function update()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local s = ESP.s
		ESP.frame += 1
		local vp = cam.ViewportSize
		local myChar = LocalPlayer.Character
		local camPos = cam.CFrame.Position
		local rainbow = s.rainbow and Color3.fromHSV((os.clock() * 0.25) % 1, 0.85, 1) or nil
		local ts = s.textSize

		for plr, o in pairs(ESP.objs) do
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local show = root ~= nil and hum ~= nil and hum.Health > 0
			if show and s.teamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team then
				show = false
			end
			local dist = 0
			if show then
				dist = (camPos - root.Position).Magnitude
				if s.maxDist < 5000 and dist > s.maxDist then
					show = false
				end
			end

			if not show then
				o.root.Visible = false
				setChams(o, false)
			else
				o.root.Visible = true
				local col = s.color
				if rainbow then
					col = rainbow
				elseif s.teamColors and plr.Team then
					col = plr.TeamColor.Color
				elseif s.visCheck then
					if (ESP.frame + o.phase) % 3 == 0 then
						local head = char:FindFirstChild("Head") or root
						local filter = { char }
						if myChar then
							filter[2] = myChar
						end
						rayParams.FilterDescendantsInstances = filter
						o.visible = Workspace:Raycast(camPos, head.Position - camPos, rayParams) == nil
					end
					col = o.visible and s.visColor or s.hidColor
				end
				setChams(o, s.chams, char, col)

				local rp = cam:WorldToViewportPoint(root.Position)
				local tp = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 2.7, 0))
				local bp = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.1, 0))
				local inFront = rp.Z > 0
				local onScreen = inFront and rp.X > -60 and rp.X < vp.X + 60 and rp.Y > -60 and rp.Y < vp.Y + 60

				-- tracer
				if s.tracers and inFront then
					local origin
					local m = s.tracerOrigin
					if m == "Bottom" then
						origin = Vector2.new(vp.X / 2, vp.Y)
					elseif m == "Center" then
						origin = vp / 2
					elseif m == "Top" then
						origin = Vector2.new(vp.X / 2, 0)
					else
						origin = UserInputService:GetMouseLocation()
					end
					o.tracer.BackgroundColor3 = col
					setLine(o.tracer, origin, Vector2.new(rp.X, bp.Y), 1.5)
				else
					o.tracer.Visible = false
				end

				if onScreen then
					o.arrow.Visible = false
					local height = math.abs(bp.Y - tp.Y)
					local width = height * 0.58
					local cx = rp.X
					local x1, y1 = cx - width / 2, tp.Y
					local style = s.boxStyle

					-- box / corners / fill
					o.box.Visible = s.box and (style == "Box" or s.boxFill)
					if o.box.Visible then
						o.box.Position = UDim2.fromOffset(x1, y1)
						o.box.Size = UDim2.fromOffset(width, height)
						o.box.BackgroundColor3 = col
						o.box.BackgroundTransparency = s.boxFill and s.fillOpacity or 1
						o.boxStroke.Enabled = style == "Box"
						o.boxStroke.Color = col
					end
					local cornerOn = s.box and style == "Corner"
					if cornerOn then
						local len, th = math.min(width, height) * 0.3, 2
						local c = o.corners
						local specs = {
							{ x1, y1, len, th },
							{ x1, y1, th, len },
							{ x1 + width - len, y1, len, th },
							{ x1 + width - th, y1, th, len },
							{ x1, y1 + height - th, len, th },
							{ x1, y1 + height - len, th, len },
							{ x1 + width - len, y1 + height - th, len, th },
							{ x1 + width - th, y1 + height - len, th, len },
						}
						for i = 1, 8 do
							local sp = specs[i]
							c[i].Position = UDim2.fromOffset(sp[1], sp[2])
							c[i].Size = UDim2.fromOffset(sp[3], sp[4])
							c[i].BackgroundColor3 = col
						end
					end
					for i = 1, 8 do
						o.corners[i].Visible = cornerOn
					end

					-- text
					local strokeT = s.textOutline and 0.35 or 1
					o.name.Visible = s.name
					if s.name then
						o.name.Text = s.nameType == "Username" and plr.Name or plr.DisplayName
						o.name.TextSize = ts
						o.name.TextColor3 = col
						o.name.TextStrokeTransparency = strokeT
						o.name.Position = UDim2.fromOffset(cx, y1 - ts - 5)
					end
					local ly = y1 + height + 3
					o.dist.Visible = s.distance
					if s.distance then
						o.dist.Text = "[" .. math.floor(dist) .. "]"
						o.dist.TextSize = ts
						o.dist.TextColor3 = col
						o.dist.TextStrokeTransparency = strokeT
						o.dist.Position = UDim2.fromOffset(cx, ly)
						ly += ts + 1
					end
					local toolInst = s.tool and char:FindFirstChildOfClass("Tool") or nil
					o.tool.Visible = toolInst ~= nil
					if toolInst then
						o.tool.Text = toolInst.Name
						o.tool.TextSize = ts
						o.tool.TextColor3 = C.hover
						o.tool.TextStrokeTransparency = strokeT
						o.tool.Position = UDim2.fromOffset(cx, ly)
					end

					-- health
					local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
					o.hpBg.Visible = s.health
					o.hpFill.Visible = s.health
					if s.health then
						o.hpBg.Position = UDim2.fromOffset(x1 - 7, y1 - 1)
						o.hpBg.Size = UDim2.fromOffset(5, height + 2)
						o.hpFill.Position = UDim2.fromOffset(x1 - 6, y1 + height * (1 - hp))
						o.hpFill.Size = UDim2.fromOffset(3, height * hp)
						o.hpFill.BackgroundColor3 = Color3.fromHSV(hp * 0.33, 1, 1)
					end
					o.hpText.Visible = s.healthText
					if s.healthText then
						o.hpText.Text = tostring(math.floor(hum.Health))
						o.hpText.TextSize = math.max(ts - 2, 8)
						o.hpText.TextColor3 = C.white
						o.hpText.TextStrokeTransparency = strokeT
						o.hpText.Position = UDim2.fromOffset(x1 - (s.health and 10 or 4), y1 + height * (1 - hp))
					end

					-- skeleton
					if s.skeleton then
						local list = hum.RigType == Enum.HumanoidRigType.R15 and SKEL_R15 or SKEL_R6
						for i, pr in ipairs(list) do
							local ln = o.skel[i]
							local a, b = char:FindFirstChild(pr[1]), char:FindFirstChild(pr[2])
							if a and b then
								local pa = cam:WorldToViewportPoint(a.Position)
								local pb = cam:WorldToViewportPoint(b.Position)
								if pa.Z > 0 and pb.Z > 0 then
									ln.BackgroundColor3 = col
									setLine(ln, Vector2.new(pa.X, pa.Y), Vector2.new(pb.X, pb.Y), 1.5)
								else
									ln.Visible = false
								end
							else
								ln.Visible = false
							end
						end
						for i = #list + 1, #o.skel do
							o.skel[i].Visible = false
						end
					else
						for i = 1, #o.skel do
							o.skel[i].Visible = false
						end
					end

					-- head dot
					local headPart = char:FindFirstChild("Head")
					o.dot.Visible = s.headDot and headPart ~= nil
					if o.dot.Visible then
						local hp2 = cam:WorldToViewportPoint(headPart.Position)
						local d = math.max(4, height * 0.1)
						o.dot.Size = UDim2.fromOffset(d, d)
						o.dot.Position = UDim2.fromOffset(hp2.X, hp2.Y)
						o.dot.BackgroundColor3 = col
					end
				else
					hideDetails(o)
					if s.arrows then
						local center = vp / 2
						local dir = Vector2.new(rp.X, rp.Y) - center
						if not inFront then
							dir = -dir
						end
						if dir.Magnitude < 1 then
							dir = Vector2.new(0, 1)
						end
						dir = dir.Unit
						local pos = center + dir * (math.min(vp.X, vp.Y) * 0.42)
						o.arrow.Position = UDim2.fromOffset(pos.X, pos.Y)
						o.arrow.Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 45
						o.arrow.BackgroundColor3 = col
						o.arrow.Visible = true
					else
						o.arrow.Visible = false
					end
				end
			end
		end
	end

	function ESP.changed()
		if ESP.onChange then
			ESP.onChange()
		end
	end

	function ESP.setEnabled(on)
		ESP.s.enabled = on
		if ESP.conn then
			ESP.conn:Disconnect()
			ESP.conn = nil
		end
		if on then
			espLayer.Visible = true
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer then
					ESP.add(p)
				end
			end
			ESP.conn = RunService.RenderStepped:Connect(function()
				pcall(update)
			end)
		else
			espLayer.Visible = false
			for p in pairs(ESP.objs) do
				ESP.remove(p)
			end
		end
	end
	onUnload(function()
		ESP.setEnabled(false)
	end)
	bindConn(Players.PlayerAdded, function(p)
		if ESP.s.enabled and p ~= LocalPlayer then
			ESP.add(p)
		end
	end)
	bindConn(Players.PlayerRemoving, function(p)
		ESP.remove(p)
	end)
end

