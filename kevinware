--========================================================================
-- CONFIG HOOKS
-- Components created with a `key` register themselves with the config
-- store (Cfg) and tell it when they change (autosave). Options understood:
--   key       config key to save under
--   noConfig  opt out even if a key is given
--   noReset   keep the current value when an imported config omits this key
--   skip      function; return true to leave this key out of exports
--   noExport  never export this key
-- The wrappers below sit on top of the components above, which are untouched.
--========================================================================
do
	local function keyed(o)
		return o.key ~= nil and not o.noConfig
	end

	-- copy of the options whose callback also tracks / flags changes for autosave
	local function hook(o, track)
		local k = keyed(o)
		if not k and not track then
			return o
		end
		local copy = {}
		for key, value in pairs(o) do
			copy[key] = value
		end
		local cb = o.callback
		copy.callback = function(...)
			if track then
				track(...)
			end
			if cb then
				cb(...)
			end
			if k then
				Cfg.dirty()
			end
		end
		return copy
	end

	-- get() returns a JSON-safe value, set(v) applies one (and fires the component's callback)
	local function register(o, get, set)
		if not keyed(o) then
			return
		end
		Cfg.add(o.key, get, function(v)
			if get() ~= v then
				set(v)
			end
		end, {
			-- a conditionally exported key (skip) being absent doesn't mean "reset it"
			noReset = o.noReset or o.skip ~= nil,
			skip = o.skip,
			noExport = o.noExport,
		})
	end

	local rawToggle = COMP.Toggle
	function COMP.Toggle(g, o)
		local api = rawToggle(g, hook(o))
		register(o, api.Get, function(v)
			api.Set(v == true)
		end)
		return api
	end

	local rawSlider = COMP.Slider
	function COMP.Slider(g, o)
		local api = rawSlider(g, hook(o))
		register(o, api.Get, function(v)
			if type(v) == "number" then
				api.Set(v)
			end
		end)
		return api
	end

	local rawDropdown = COMP.Dropdown
	function COMP.Dropdown(g, o)
		local api = rawDropdown(g, hook(o))
		register(o, api.Get, function(v)
			if table.find(o.options, v) then
				api.Set(v)
			end
		end)
		return api
	end

	local rawSegmented = COMP.Segmented
	function COMP.Segmented(g, o)
		local api = rawSegmented(g, hook(o))
		register(o, api.Get, function(v)
			if table.find(o.options, v) then
				api.Set(v)
			end
		end)
		return api
	end

	-- swatches have no getter of their own, so track the selection here
	local rawSwatches = COMP.Swatches
	function COMP.Swatches(g, o)
		local cur = o.default
		local cb = o.callback
		local valid = {}
		for _, item in ipairs(o.items) do
			valid[item.name] = true
		end
		local api = rawSwatches(
			g,
			hook(o, function(name)
				cur = name
			end)
		)
		local rawSet = api.Set
		function api.Set(name)
			cur = name
			rawSet(name)
		end
		function api.Get()
			return cur
		end
		register(o, api.Get, function(v)
			if valid[v] then
				api.Set(v)
				if cb then
					cb(v)
				end
			end
		end)
		return api
	end

	-- colours are stored as hex strings so they survive JSON
	local rawPicker = COMP.ColorPicker
	function COMP.ColorPicker(g, o)
		local api = rawPicker(g, hook(o))
		register(o, function()
			return toHex(api.Get())
		end, function(hex)
			local c = type(hex) == "string" and fromHex(hex)
			if c then
				api.Set(c)
			end
		end)
		return api
	end

	-- keybinds are stored by KeyCode name
	local rawKeybind = COMP.Keybind
	function COMP.Keybind(g, o)
		local cur = o.default
		local api = rawKeybind(
			g,
			hook(o, function(k)
				cur = k
			end)
		)
		local btn = api.Row:FindFirstChildOfClass("TextButton")
		local lbl = btn and btn:FindFirstChildOfClass("TextLabel")
		if lbl then
			-- keep the button text matching the real key (e.g. after Escape-cancelling a rebind
			-- once a config has changed the key)
			lbl:GetPropertyChangedSignal("Text"):Connect(function()
				local want = keyName(cur)
				if lbl.Text ~= want and lbl.Text ~= "Press a key..." then
					lbl.Text = want
				end
			end)
		end
		function api.Get()
			return cur
		end
		function api.Set(k, silent)
			cur = k
			if lbl then
				lbl.Text = keyName(k)
			end
			if not silent and o.callback then
				o.callback(k)
			end
		end
		register(o, function()
			return cur.Name
		end, function(name)
			local ok, k = pcall(function()
				return Enum.KeyCode[name]
			end)
			if ok and typeof(k) == "EnumItem" then
				api.Set(k)
			end
		end)
		return api
	end
end

