			Snow.enabled = on
			Snow.refresh()
		end,
	})
	COMP.Slider(gFx, {
		key = "fx.snowAmount",
		text = "Snow amount",
		min = 10,
		max = 100,
		step = 5,
		default = 50,
		suffix = "%",
		callback = function(v)
			Snow.amount = v / 100
			Snow.build(math.floor(Snow.max * Snow.amount + 0.5))
		end,
	})
	COMP.Slider(gFx, {
		key = "fx.snowSpeed",
		text = "Snow speed",
		min = 0.3,
		max = 3,
		step = 0.1,
		default = 1,
		suffix = "x",
		callback = function(v)
			Snow.speed = v
		end,
	})

	-- ---- interface
	local gUi = COMP.Group(page, "Interface")
	COMP.Keybind(gUi, {
		key = "ui.key",
		text = "Toggle key",
		default = CONFIG.ToggleKey,
		callback = function(key)
			CONFIG.ToggleKey = key
		end,
	})
	COMP.Slider(gUi, {
		key = "ui.scale",
		text = "UI scale",
		min = 80,
		max = 130,
		step = 5,
		default = 100,
		suffix = "%",
		callback = function(v)
			setUiScale(v / 100)
		end,
	})

	-- ---- config
	local gCfg = COMP.Group(page, "Config")
	local importInput
	autoToggle = COMP.Toggle(gCfg, {
		text = "Auto config",
		desc = "Saves your settings and loads them every time you execute",
		default = false,
		callback = function(on)
			if on and not Cfg.canFile() then
				toast("Auto config unavailable", "Your executor can't read or write files.", 3.5)
				autoToggle.Set(false, true)
				return
			end
			Cfg.auto = on
			Cfg.saveFile()
			toast(on and "Auto config on" or "Auto config off", on and "Settings save automatically." or nil)
		end,
	})
	COMP.Button(gCfg, {
		text = "Copy config",
		desc = "Copies a code with all your settings",
		buttonText = "Copy",
		callback = function()
			local code = Cfg.encode()
			if Cfg.copy(code) then
				toast("Config copied", "Paste the code anywhere to share it.")
			else
				importInput.Box.Text = code
				toast("Clipboard unavailable", "The code is in the box below, copy it from there.", 4)
			end
		end,
	})
	importInput = COMP.Input(gCfg, {
		text = "Import config",
		desc = "Paste a config code (starts with KW1:)",
		placeholder = "KW1:...",
		buttonText = "Import",
		callback = function(text)
			local data = Cfg.decode(text)
			if not data then
				toast("Invalid config code", "A config code starts with KW1:")
				return
			end
			local n = Cfg.apply(data)
			Cfg.dirty()
			toast("Config imported", n .. " settings applied")
		end,
	})

	-- ---- script
	local gScript = COMP.Group(page, "Script")
	local armed = false
	COMP.Button(gScript, {
		text = "Unload script",
		desc = "Restores your game and removes the UI",
		buttonText = "Unload",
		style = "danger",
		callback = function(btn)
			if armed then
				armed = false
				doUnload()
				return
			end
			armed = true
			btn.SetText("Confirm")
			task.delay(3, function()
				if armed then
					armed = false
					btn.SetText("Unload")
				end
			end)
		end,
	})
end

