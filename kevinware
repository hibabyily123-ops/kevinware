local panelToken = 0
local shownTab
local function showPanel(t, switching)
	panelToken += 1
	local prev = shownTab
	shownTab = t
	if prev and prev ~= t then
		tween(prev.holder, 0.12, { GroupTransparency = 1 })
		task.delay(0.13, function()
			if shownTab ~= prev then
				prev.holder.Visible = false
			end
		end)
	end
	t.holder.Visible = true
	t.holder.GroupTransparency = 1
	t.holderScale.Scale = 0.985
	tween(t.holder, 0.3, { GroupTransparency = 0 })
	tween(t.holderScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	if switching and panelHolder.Visible then
		return
	end
	panelHolder.Visible = true
	panelHolder.Position = UDim2.new(0.5, 0, 0, M.PanelY - 22)
	panelScale.Scale = 0.94
	tween(panelHolder, 0.55, { Position = UDim2.new(0.5, 0, 0, M.PanelY) })
	tween(panelScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(panel, 0.3, { GroupTransparency = 0 })
	tween(panelStroke, 0.3, { Transparency = 0 })
	for i, l in ipairs(panelShadow) do
		tween(l, 0.45, { BackgroundTransparency = SHADOW_T[i] })
	end
end

local function hidePanel()
	panelToken += 1
	local token = panelToken
	local leaving = shownTab
	shownTab = nil
	tween(panelHolder, 0.3, { Position = UDim2.new(0.5, 0, 0, M.PanelY - 14) })
	tween(panelScale, 0.3, { Scale = 0.96 })
	tween(panel, 0.22, { GroupTransparency = 1 })
	tween(panelStroke, 0.22, { Transparency = 1 })
	for _, l in ipairs(panelShadow) do
		tween(l, 0.22, { BackgroundTransparency = 1 })
	end
	task.delay(0.32, function()
		if token == panelToken then
			panelHolder.Visible = false
			if leaving then
				leaving.holder.Visible = false
				leaving.holder.GroupTransparency = 1
			end
		end
	end)
end

