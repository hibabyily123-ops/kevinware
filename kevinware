function Env.timePreset(name)
	local p = TIMES[name]
	if not p then
		return
	end
	local props = {}
	for k, v in pairs(p.light) do
		props[k] = v
	end
	Env.set(props, 1.6)
	Env.skyProps = { StarCount = 3000, CelestialBodiesShown = true }
	Env.atmosProps = p.atmos
	Env.useDefaultSky()
	Env.syncAll()
end

function Env.reset()
	Env.desired = {}
	Env.busy = 0
	Env.touched = false
	for p, v in pairs(Env.orig) do
		pcall(function()
			Lighting[p] = v
		end)
	end
	Env.resetSky()
	Env.syncGrade()
	if Env.cloudsCreated then
		Env.cloudsCreated:Destroy()
		Env.cloudsCreated = nil
	end
	if Env.cloudsOrig and Env.cloudsOrigInst and Env.cloudsOrigInst.Parent then
		restoreProps(Env.cloudsOrigInst, Env.cloudsOrig)
	end
end
onUnload(Env.reset)

