	local function clockText(v)
		local h = math.floor(v)
		local m = math.floor((v - h) * 60 + 0.5)
		if m == 60 then
			h += 1
			m = 0
		end
		return string.format("%02d:%02d", h % 24, m)
	end

	-- ---- time of day
	local gTime = COMP.Group(page, "Time of day")
	Env.ui.time = COMP.Segmented(gTime, {
