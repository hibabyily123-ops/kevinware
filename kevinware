--========================================================================
-- LOADER  (clear glass loading screen -> question -> profile -> bar)
--========================================================================
local function runLoader()
	local overlay = new("Frame", {
		Name = "Loader",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = rgb(6, 8, 14),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Active = true,
		BorderSizePixel = 0,
	}, gui)
	-- light vignette: the game stays visible (blurred) through the middle
	new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(0.5, 0.74),
			NumberSequenceKeypoint.new(1, 0.5),
		}),
	}, overlay)
	tween(overlay, 0.9, { BackgroundTransparency = 0 })
	tween(blur, 1.1, { Size = 26 })

	local alive = true

	local function glassCard(w, h, posY, kind)
		local holder = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, posY),
			Size = UDim2.fromOffset(w, h),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
		}, overlay)
		local sc = new("UIScale", { Scale = 0.92 }, holder)
		local shadows = makeShadow(holder, 28, true)
		local card = new("CanvasGroup", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			GroupTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 1,
		}, holder)
		corner(card, 28)
		local st = glassStroke(card)
		st.Transparency = 1
		local bg = frame({
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = C.white,
			BackgroundTransparency = 0.08,
			ZIndex = 0,
		}, card)
		local grad = new("UIGradient", { Rotation = 90 }, bg)
		local setG = gradientSetter(grad)
		Theme.bind(function(v, instant)
			if kind == "panel" then
				setG(v.panelTop, v.panelBot, instant and 0 or 0.3)
			else
				setG(v.barTop, v.barBot, instant and 0 or 0.3)
			end
		end)
		local obj = { Card = card }
		function obj.Show()
			holder.Visible = true
			tween(card, 0.55, { GroupTransparency = 0 })
			tween(st, 0.55, { Transparency = 0 })
			tween(sc, 0.8, { Scale = 1 }, Enum.EasingStyle.Back)
			for i, l in ipairs(shadows) do
				tween(l, 0.55, { BackgroundTransparency = SHADOW_T[i] })
			end
		end
		function obj.Hide()
			tween(card, 0.35, { GroupTransparency = 1 })
			tween(st, 0.35, { Transparency = 1 })
			tween(sc, 0.35, { Scale = 0.95 })
			for _, l in ipairs(shadows) do
				tween(l, 0.3, { BackgroundTransparency = 1 })
			end
			task.delay(0.4, function()
				holder.Visible = false
			end)
		end
		return obj
	end

	-- ---------- stage: logo, halo rings, wordmark
	local stage = new("Frame", {
		Name = "Stage",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -30),
		Size = UDim2.fromOffset(320, 220),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, overlay)
	local stageScale = new("UIScale", { Scale = 1 }, stage)

	local function haloRing(delay)
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, 70),
			Size = UDim2.fromOffset(92, 92),
			BackgroundTransparency = 1,
		}, stage)
		corner(f, 999)
		local st = stroke(f, 1, C.white, 2)
		Theme.bind(function(v)
			st.Color = v.accent
		end)
		local sc = new("UIScale", { Scale = 1 }, f)
		task.spawn(function()
			task.wait(delay)
			while alive do
				sc.Scale = 1
				st.Transparency = 0.6
				tween(sc, 2.4, { Scale = 2.2 }, Enum.EasingStyle.Quad)
				local tw = tween(st, 2.4, { Transparency = 1 }, Enum.EasingStyle.Quad)
				tw.Completed:Wait()
			end
			f:Destroy()
		end)
	end

	local logo, logoScale = buildLogo(92, stage)
	logo.Position = UDim2.new(0.5, 0, 0, 70)
	logo.GroupTransparency = 1
	logoScale.Scale = 0.6

	local word = string.upper(CONFIG.Name)
	local TRACK = 8
	local widths, total = {}, 0
	for i = 1, #word do
		widths[i] = textWidth(word:sub(i, i), 17, Enum.Font.GothamSemibold)
		total += widths[i]
	end
	total += TRACK * (#word - 1)
	local letters, xs = {}, {}
	do
		local cx = -total / 2
		for i = 1, #word do
			xs[i] = cx
			letters[i] = label({
				Text = word:sub(i, i),
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0.5, cx, 0, 160),
				Size = UDim2.fromOffset(widths[i] + 2, 22),
				Font = Enum.Font.GothamSemibold,
				TextSize = 17,
				TextTransparency = 1,
			}, stage)
			cx += widths[i] + TRACK
		end
	end

	-- ---------- progress
	local progress = new("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 112),
		Size = UDim2.fromOffset(240, 44),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		BorderSizePixel = 0,
	}, overlay)
	local track = frame({
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.fromOffset(240, 4),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.88,
	}, progress)
	corner(track, 2)
	local fill = frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.white }, track)
	corner(fill, 2)
	new("UIGradient", { Color = ColorSequence.new(C.white, rgb(185, 188, 196)) }, fill)
	Theme.bind(function(v, instant)
		setProps(fill, instant and 0 or 0.3, { BackgroundColor3 = v.accent })
	end)
	local status = label({
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.fromOffset(170, 16),
		TextColor3 = C.sub,
		TextSize = 12,
		TextTransparency = 1,
	}, progress)
	local pct = label({
		Text = "0%",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 18),
		Size = UDim2.fromOffset(60, 16),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.sub,
		TextSize = 12,
	}, progress)
	local pv = Instance.new("NumberValue")
	pv.Changed:Connect(function()
		pct.Text = math.floor(pv.Value * 100 + 0.5) .. "%"
	end)

	local function fadeSwap(textLabel, text)
		tween(textLabel, 0.12, { TextTransparency = 1 })
		task.wait(0.13)
		textLabel.Text = text
		tween(textLabel, 0.2, { TextTransparency = 0 })
	end

	-- ---------- prompt card
	local prompt = glassCard(430, 200, 62, "bar")
	label({
		Text = "Are you here to use " .. CONFIG.Name .. " today?",
		Position = UDim2.new(0.5, -195, 0, 26),
		Size = UDim2.fromOffset(390, 56),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = true,
		Font = Enum.Font.GothamSemibold,
		TextSize = 22,
	}, prompt.Card)
	label({
		Text = "Choose one to continue.",
		Position = UDim2.new(0.5, -195, 0, 86),
		Size = UDim2.fromOffset(390, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.sub,
		TextSize = 13,
	}, prompt.Card)
	local btnRow = frame({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 126),
		Size = UDim2.fromOffset(346, 46),
		BackgroundTransparency = 1,
	}, prompt.Card)
	local yes = makeButton(btnRow, "Yes", "primary", 170, 46, { Position = UDim2.fromOffset(0, 0) })
	local no = makeButton(btnRow, "No", "ghost", 170, 46, { Position = UDim2.fromOffset(176, 0) })

	-- ---------- profile card
	local profileCard = glassCard(320, 308, 20, "panel")
	local pc = profileCard.Card
	label({
		Text = "Profile",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 30),
		Size = UDim2.fromOffset(200, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Enum.Font.GothamSemibold,
		TextSize = 16,
	}, pc)
	local avatar = frame({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(108, 108),
		BackgroundColor3 = rgb(36, 37, 40),
	}, pc)
	corner(avatar, 54)
	local avatarImg = new("ImageLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Image = "",
		ImageTransparency = 1,
	}, avatar)
	corner(avatarImg, 54)
	local shimmer = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.white }, avatar)
	corner(shimmer, 54)
	local shimmerGrad = new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.78),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Offset = Vector2.new(-1, 0),
	}, shimmer)
	local nameL = label({
		Text = LocalPlayer.DisplayName,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 192),
		Size = UDim2.fromOffset(280, 24),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Enum.Font.GothamBold,
		TextSize = 19,
		TextTransparency = 1,
	}, pc)
	local handleL = label({
		Text = "@" .. LocalPlayer.Name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 216),
		Size = UDim2.fromOffset(280, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = rgb(170, 173, 180),
		TextSize = 13,
		TextTransparency = 1,
	}, pc)
	local chips = new("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 248),
		Size = UDim2.fromOffset(300, 28),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		BorderSizePixel = 0,
	}, pc)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
	}, chips)
	local function chip(text)
		local f = frame({
			Size = UDim2.fromOffset(textWidth(text, 12) + 24, 26),
			BackgroundColor3 = C.black,
			BackgroundTransparency = 0.6,
		}, chips)
		corner(f, 13)
		stroke(f, 0.9)
		label({
			Text = text,
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextSize = 12,
		}, f)
	end
	chip(LocalPlayer.AccountAge .. " days on Roblox")
	chip(LocalPlayer.MembershipType == Enum.MembershipType.Premium and "Premium" or "Standard")

	-- =============== timeline ===============
	task.wait(0.7)
	tween(logo, 0.8, { GroupTransparency = 0 })
	tween(logoScale, 1, { Scale = 1 }, Enum.EasingStyle.Back)
	haloRing(0.2)
	haloRing(1.4)
	task.spawn(function()
		task.wait(1)
		while alive do
			local tw = tween(logoScale, 1.5, { Scale = 1.045 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			tw.Completed:Wait()
			local tw2 = tween(logoScale, 1.5, { Scale = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			tw2.Completed:Wait()
		end
	end)
	task.wait(0.4)
	for i, l in ipairs(letters) do
		task.delay(0.06 * i, function()
			l.Position = UDim2.new(0.5, xs[i], 0, 170)
			tween(l, 0.6, { TextTransparency = 0, Position = UDim2.new(0.5, xs[i], 0, 160) })
		end)
	end
	task.wait(0.9)
	tween(progress, 0.5, { GroupTransparency = 0 })
	local steps = {
		{ "Starting up", 0.14 },
		{ "Loading modules", 0.38 },
		{ "Building interface", 0.66 },
		{ "Syncing your profile", 0.88 },
		{ "Ready", 1 },
	}
	for _, st in ipairs(steps) do
		task.spawn(fadeSwap, status, st[1])
		tween(fill, 0.6, { Size = UDim2.fromScale(st[2], 1) })
		tween(pv, 0.6, { Value = st[2] })
		task.wait(0.5 + math.random() * 0.3)
	end
	task.wait(0.3)
	tween(progress, 0.35, { GroupTransparency = 1 })
	tween(stage, 0.7, { Position = UDim2.new(0.5, 0, 0.5, -170) })
	tween(stageScale, 0.7, { Scale = 0.78 })
	task.wait(0.45)

	prompt.Show()
	local answered = Instance.new("BindableEvent")
	yes.Button.MouseButton1Click:Connect(function()
		answered:Fire(true)
	end)
	no.Button.MouseButton1Click:Connect(function()
		answered:Fire(false)
	end)
	local ans = answered.Event:Wait()
	answered:Destroy()
	prompt.Hide()

	if not ans then
		task.wait(0.4)
		local bye = label({
			Text = "See you next time.",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 40),
			Size = UDim2.fromOffset(400, 30),
			TextXAlignment = Enum.TextXAlignment.Center,
			Font = Enum.Font.GothamSemibold,
			TextSize = 20,
			TextTransparency = 1,
		}, overlay)
		tween(bye, 0.45, { TextTransparency = 0 })
		task.wait(1.3)
		alive = false
		tween(bye, 0.3, { TextTransparency = 1 })
		tween(logo, 0.4, { GroupTransparency = 1 })
		for _, l in ipairs(letters) do
			tween(l, 0.4, { TextTransparency = 1 })
		end
		tween(overlay, 0.7, { BackgroundTransparency = 1 })
		tween(blur, 0.7, { Size = 0 })
		task.wait(0.8)
		overlay:Destroy()
		Unload()
		return
	end

	-- profile
	alive = false
	tween(logo, 0.45, { GroupTransparency = 1 })
	for _, l in ipairs(letters) do
		tween(l, 0.4, { TextTransparency = 1 })
	end
	task.wait(0.4)
	profileCard.Show()

	local shimmerOn = true
	task.spawn(function()
		while shimmerOn do
			shimmerGrad.Offset = Vector2.new(-1, 0)
			local tw = tween(shimmerGrad, 1.1, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			tw.Completed:Wait()
		end
	end)
	local thumbUrl, thumbDone = nil, false
	task.spawn(function()
		local ok, url = pcall(function()
			return (Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size420x420))
		end)
		if ok then
			thumbUrl = url
		end
		thumbDone = true
	end)
	local t0 = os.clock()
	while (not thumbDone and os.clock() - t0 < 5) or os.clock() - t0 < 1.5 do
		task.wait(0.05)
	end
	if thumbUrl then
		avatarImg.Image = thumbUrl
		tween(avatarImg, 0.5, { ImageTransparency = 0 })
	end
	shimmerOn = false
	tween(shimmer, 0.4, { BackgroundTransparency = 1 })
	tween(nameL, 0.45, { TextTransparency = 0 })
	task.wait(0.15)
	tween(handleL, 0.45, { TextTransparency = 0 })
	task.wait(0.15)
	tween(chips, 0.45, { GroupTransparency = 0 })
	task.wait(1.5)

	-- into the bar
	profileCard.Hide()
	task.wait(0.35)
	state.ready = true
	setShown(true)
	tween(overlay, 0.9, { BackgroundTransparency = 1 })
	tween(blur, 1, { Size = 0 })
	task.wait(1)
	overlay:Destroy()
	if state.configLoaded then
		toast("Config loaded", "Your saved settings were applied.")
	end
end

--========================================================================
-- INPUT + API + BOOT
--========================================================================
bindConn(UserInputService.InputBegan, function(input)
	if input.KeyCode ~= CONFIG.ToggleKey then
		return
	end
	if not state.ready or state.listening then
		return
	end
	if UserInputService:GetFocusedTextBox() then
		return
	end
	setShown(not state.shown)
end)

local API = {
	Tabs = Tabs,
	Components = COMP,
	Theme = Theme,
	Config = CONFIG,
	Cfg = Cfg,
	Perf = Perf,
	Env = Env,
	Gui = gui,
	Toast = toast,
}
function API.Show()
	setShown(true)
end
function API.Hide()
	setShown(false)
end
function API.Toggle()
	setShown(not state.shown)
end
function API.Minimize(v)
	if v == nil then
		v = not state.minimized
	end
	setMinimized(v)
end
function API.Select(id)
	for _, t in ipairs(TABS) do
		if t.id == id then
			if state.minimized then
				setMinimized(false)
			end
			setActive(t)
			return
		end
	end
end
function API.Unload()
	Unload()
end

Unload = function()
	if unloaded then
		return
	end
	unloaded = true
	state.ready = false
	for i = #cleanups, 1, -1 do
		pcall(cleanups[i])
	end
	pcall(function()
		if getgenv and getgenv().Kevinware == API then
			getgenv().Kevinware = nil
		end
	end)
end

pcall(function()
	getgenv().Kevinware = API
end)

-- auto config: load the saved config if the user turned it on
do
	local data = Cfg.loadFile()
	if data and data.auto then
		Cfg.apply(data)
		Cfg.auto = true
		if autoToggle then
			autoToggle.Set(true, true)
		end
		state.configLoaded = true
	end
end

setUiScale(uiScaleValue)
if CONFIG.ShowLoader then
	task.spawn(runLoader)
else
	state.ready = true
	setShown(true)
end

return API
