function Env.skyTheme(name)
	if name == "Game default" then
		Env.resetSky()
		return
	end
	Env.touched = true
	local pack = SKY_PACKS[name]
	if pack then
		local faces = {}
		for face, id in pairs(pack) do
			faces["Skybox" .. face] = "rbxassetid://" .. id
		end
		Env.skyFaces = faces
		Env.skyFacesForce = true
		Env.skyProps = { StarCount = 0, CelestialBodiesShown = false }
		Env.atmosProps = { Density = 0, Offset = 0, Color = C.white, Decay = C.white, Glare = 0, Haze = 0 }
		Env.fx = nil
		Env.syncAll()
		return
	end
	local def = SKY_THEMES[name]
	if not def then
		return
	end
	Env.skyFaces = nil
	Env.skyFacesForce = false
	Env.skyProps = def.sky
	Env.atmosProps = def.atmos
	Env.fx = def.fx
	Env.useDefaultSky()
	if def.light then
		Env.set(def.light, 1.6)
	end
	if def.clouds then
		Env.cloudsTheme(def.clouds)
	end
	Env.syncAll()
end

function Env.customSky(text)
	local ids = {}
	for id in string.gmatch(text or "", "%d+") do
		table.insert(ids, id)
	end
	if #ids ~= 1 and #ids ~= 6 then
		return false
	end
	local order = { "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }
	local faces = {}
	for i, face in ipairs(order) do
		faces[face] = "rbxassetid://" .. ids[#ids == 1 and 1 or i]
	end
	Env.touched = true
	Env.skyFaces = faces
	Env.skyFacesForce = true
	Env.skyProps = { StarCount = 0, CelestialBodiesShown = false }
	Env.atmosProps = { Density = 0, Offset = 0, Color = C.white, Decay = C.white, Glare = 0, Haze = 0 }
	Env.fx = nil
	Env.syncAll()
	return true
end

-- ---- clouds
function Env.getClouds(create)
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return nil
	end
	local c = terrain:FindFirstChildOfClass("Clouds")
	if c then
		if not Env.cloudsOrig and c ~= Env.cloudsCreated then
			Env.cloudsOrig = capture(c, CLOUD_PROPS)
			Env.cloudsOrigInst = c
		end
		return c
	elseif create then
		local n = Instance.new("Clouds")
		n.Parent = terrain
		Env.cloudsCreated = n
		return n
	end
	return nil
end

function Env.clouds(on, cover)
	local c = Env.getClouds(true)
	if not c then
		return
	end
	if on ~= nil then
		c.Enabled = on
	end
	if cover ~= nil then
		c.Cover = cover
	end
end

