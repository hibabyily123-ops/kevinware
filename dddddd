		local inner = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = C.white,
		}, b)
		corner(inner, 14)
		new("UIGradient", { Rotation = 45, Color = ColorSequence.new(item.color1, item.color2) }, inner)
		chips[item.name] = { ring = ring, scale = sc }
		b.MouseEnter:Connect(function()
			if selected ~= item.name then
				tween(sc, 0.2, { Scale = 1 })
			end
		end)
		b.MouseLeave:Connect(function()
			if selected ~= item.name then
				tween(sc, 0.2, { Scale = 0.9 })
			end
		end)
		b.MouseButton1Click:Connect(function()
			selected = item.name
			render()
			if o.callback then
				o.callback(item.name)
			end
		end)
	end
	render()

	local api = { Row = r }
	function api.Get()
		return selected or "Custom"
	end
	function api.Set(name, silent)
		selected = name
		render()
		if not silent and name and o.callback then
			o.callback(name)
		end
	end
	return api
end

