local panelToken = 0
local shownTab
local function showPanel(t, switching)
	panelToken += 1
	local prev = shownTab
	shownTab = t
	if prev and prev ~= t then
		tween(prev.holder, 0.12, { GroupTransparency = 1 })
		task.delay(0.13, function()
			if shownTab ~= prev then
				prev.holder.Visible = false
			end
		end)
	end
	t.holder.Visible = true
	t.holder.GroupTransparency = 1
	t.holderScale.Scale = 0.985
	tween(t.holder, 0.3, { GroupTransparency = 0 })
	tween(t.holderScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	if switching and panelHolder.Visible then
		return
	end
	panelHolder.Visible = true
	panelHolder.Position = UDim2.new(0.5, 0, 0, M.PanelY - 22)
	panelScale.Scale = 0.94
	tween(panelHolder, 0.55, { Position = UDim2.new(0.5, 0, 0, M.PanelY) })
