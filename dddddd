		Position = UDim2.fromOffset(16, 46),
		Size = UDim2.new(1, -32, 0, 38),
		BackgroundTransparency = 1,
	}, r)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 10),
		VerticalAlignment = Enum.VerticalAlignment.Center,
	}, row)

	local selected = o.default
	local chips = {}
	local function render()
		nameLabel.Text = selected or "Custom"
		for name, c in pairs(chips) do
			local on = name == selected
			tween(c.ring, 0.25, { Transparency = on and 0 or 1 })
			tween(c.scale, 0.35, { Scale = on and 1 or 0.9 }, Enum.EasingStyle.Back)
		end
	end
	for _, item in ipairs(o.items) do
		local b = new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(38, 38),
		}, row)
