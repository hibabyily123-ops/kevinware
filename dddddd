--========================================================================
-- ACCESS  (Aim tab gate + Owner tab)
-- NOTE: a gate inside a client script is only a UI lock. Anyone who can read the
-- script can remove it. Real protection needs the aim code itself to be served
-- by the backend after approval.
--========================================================================
local Access = {
	status = "checking",
	expires = nil,
	err = nil,
	listeners = {},
	gated = {}, -- group wrappers that only approved users can see
	ownerKey = Cfg.readText("ownerkey") or "",
}

local function httpReq(method, path, body, key)
	if ACCESS.Api == "" then
		return nil, "offline"
	end
	local fn = (syn and syn.request) or request or http_request or (http and http.request)
	if type(fn) ~= "function" then
		return nil, "executor has no http function"
	end
	local HttpService = game:GetService("HttpService")
	local headers = { ["Content-Type"] = "application/json" }
	if key and key ~= "" then
		headers["x-owner-key"] = key
	end
	local ok, res = pcall(fn, {
		Url = ACCESS.Api .. path,
		Method = method,
		Headers = headers,
		Body = body and HttpService:JSONEncode(body) or nil,
	})
	if not ok or type(res) ~= "table" then
		return nil, "request failed"
	end
	if res.StatusCode ~= 200 then
		return nil, "HTTP " .. tostring(res.StatusCode)
	end
	local ok2, data = pcall(function()
		return HttpService:JSONDecode(res.Body)
	end)
	if not ok2 then
		return nil, "bad response"
	end
	return data
end

local function timeLeft(expires)
	if not expires then
		return "permanent"
	end
	local s = expires - os.time()
	if s <= 0 then
		return "expired"
	end
	local dd = math.floor(s / 86400)
	local h = math.floor((s % 86400) / 3600)
	local m = math.floor((s % 3600) / 60)
	if dd > 0 then
		return dd .. "d " .. h .. "h left"
	end
	if h > 0 then
		return h .. "h " .. m .. "m left"
	end
	return m .. "m left"
end

function Access.has()
	return Access.status == "owner" or Access.status == "granted"
end

function Access.fire()
	for _, fn in ipairs(Access.listeners) do
		pcall(fn)
	end
end

function Access.refresh()
	if IS_OWNER then
		Access.status = "owner"
		Access.fire()
		return
	end
	if ACCESS.Api == "" then
		Access.status = "offline"
		Access.fire()
		return
	end
	local data, err = httpReq("GET", "/access/" .. LocalPlayer.UserId)
	if not data then
		Access.status, Access.err = "error", err
	elseif data.granted and (not data.expires or data.expires > os.time()) then
		Access.status, Access.expires = "granted", data.expires
	elseif data.granted then
		Access.status = "expired"
	elseif data.pending then
		Access.status = "pending"
	elseif data.denied then
		Access.status = "denied"
	else
		Access.status = "none"
	end
	Access.fire()
end

function Access.request()
	if ACCESS.Api == "" then
		return false, "The access server isn't set up yet."
	end
	local data, err = httpReq("POST", "/request", {
		userId = LocalPlayer.UserId,
		username = LocalPlayer.Name,
		displayName = LocalPlayer.DisplayName,
		accountAge = LocalPlayer.AccountAge,
	})
	if not data then
		return false, "Couldn't send the request (" .. tostring(err) .. ")."
	end
	Access.status = "pending"
	Access.fire()
	return true
end

