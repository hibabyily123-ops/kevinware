-- ICONS (drawn from frames, strokes and rounded lines; 24x24 design grid)
--========================================================================
local function buildIcon(kind, size, parent, color, thickness)
	local s = size / 24
	local TH = thickness or 2
	local holder = new("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
	}, parent)

	local parts = {}
	local function reg(obj, prop)
		table.insert(parts, { obj, prop })
	end

	local function line(x1, y1, x2, y2)
		local dx, dy = (x2 - x1) * s, (y2 - y1) * s
		local len = math.sqrt(dx * dx + dy * dy)
		local props = {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2 * s, (y1 + y2) / 2 * s),
			BackgroundColor3 = color,
		}
		if dy == 0 then
			props.Size = UDim2.fromOffset(len + TH, TH)
		elseif dx == 0 then
			props.Size = UDim2.fromOffset(TH, len + TH)
		else
			props.Size = UDim2.fromOffset(len + TH, TH)
			props.Rotation = math.deg(math.atan2(dy, dx))
		end
		local f = frame(props, holder)
		corner(f, 99)
		reg(f, "BackgroundColor3")
	end

	local function ring(cx, cy, r)
		local d = math.max(r * 2 * s - TH, 1)
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * s, cy * s),
			Size = UDim2.fromOffset(d, d),
			BackgroundTransparency = 1,
		}, holder)
		corner(f, 999)
		reg(stroke(f, 0, color, TH), "Color")
	end

	local function dot(cx, cy, d)
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * s, cy * s),
			Size = UDim2.fromOffset(d * s, d * s),
			BackgroundColor3 = color,
		}, holder)
		corner(f, 999)
		reg(f, "BackgroundColor3")
	end

	local function pill(cx, cy, w, h, r)
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * s, cy * s),
			Size = UDim2.fromOffset(w * s, h * s),
			BackgroundColor3 = color,
		}, holder)
		corner(f, r and r * s or 999)
		reg(f, "BackgroundColor3")
	end

	local function box(cx, cy, w, h, r)
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * s, cy * s),
			Size = UDim2.fromOffset(math.max(w * s - TH, 1), math.max(h * s - TH, 1)),
			BackgroundTransparency = 1,
		}, holder)
		corner(f, r * s)
		reg(stroke(f, 0, color, TH), "Color")
	end

	local function seg(x1, x2, y)
		if x2 - x1 >= 0.01 then
			line(x1, y, x2, y)
		end
	end

	if kind == "aim" then
		ring(12, 12, 9)
		line(12, 3, 12, 7)
		line(12, 21, 12, 17)
		line(3, 12, 7, 12)
		line(21, 12, 17, 12)
		dot(12, 12, 3)
	elseif kind == "movement" then
		line(4, 6, 10, 12)
		line(10, 12, 4, 18)
		line(13, 6, 19, 12)
		line(19, 12, 13, 18)
	elseif kind == "esp" then
		line(3, 3, 8, 3)
		line(3, 3, 3, 8)
		line(21, 3, 16, 3)
		line(21, 3, 21, 8)
		line(3, 21, 8, 21)
		line(3, 21, 3, 16)
		line(21, 21, 16, 21)
		line(21, 21, 21, 16)
		dot(12, 9.5, 4.5)
		pill(12, 16.2, 9, 5)
	elseif kind == "macros" then
		box(12, 12, 20, 14, 3.5)
		dot(7.5, 10, 2.2)
		dot(12, 10, 2.2)
		dot(16.5, 10, 2.2)
		line(8.5, 14.5, 15.5, 14.5)
	elseif kind == "environment" then
		ring(12, 12, 4.2)
		line(12, 2.5, 12, 5)
		line(12, 19, 12, 21.5)
		line(2.5, 12, 5, 12)
		line(19, 12, 21.5, 12)
		line(5.3, 5.3, 7, 7)
		line(17, 17, 18.7, 18.7)
		line(18.7, 5.3, 17, 7)
		line(7, 17, 5.3, 18.7)
	elseif kind == "settings" then
		seg(3, 11, 6)
		dot(16, 6, 5)
		seg(13, 21, 12)
		dot(8, 12, 5)
		seg(3, 9, 18)
		seg(19, 21, 18)
		dot(14, 18, 5)
	elseif kind == "lock" then
		box(12, 8.5, 9, 10, 4.5)
		pill(12, 16, 15, 9.5, 3)
	elseif kind == "owner" then
		line(3, 18, 21, 18)
		line(3, 18, 3, 8)
		line(3, 8, 8, 13)
		line(8, 13, 12, 6)
		line(12, 6, 16, 13)
		line(16, 13, 21, 8)
		line(21, 8, 21, 18)
	elseif kind == "cross" then
		line(5, 5, 19, 19)
		line(19, 5, 5, 19)
	elseif kind == "chevron" then
		line(6, 9, 12, 15)
		line(12, 15, 18, 9)
	elseif kind == "check" then
		line(5, 12.5, 10, 17.5)
		line(10, 17.5, 19, 7)
	elseif kind == "k" then
		line(7, 4, 7, 20)
		line(16.5, 4, 8, 12.3)
		line(10.4, 10.4, 17, 20)
	end

	local api = { holder = holder }
	function api.SetColor(c, t)
		for _, p in ipairs(parts) do
			if t and t > 0 then
				tween(p[1], t, { [p[2]] = c })
			else
				p[1][p[2]] = c
			end
		end
	end
	return api
end

-- Kevinware mark: two stacked glass tiles with a bold K, tinted by the accent colour
local function buildLogo(size, parent)
	local holder = new("CanvasGroup", {
		Name = "Logo",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
	}, parent)
	local sc = new("UIScale", { Scale = 1 }, holder)
	local fs = math.floor(size * 0.78)
	local off = size - fs
	local r = math.floor(fs * 0.3)

	local back = frame({
		Position = UDim2.fromOffset(off, off),
		Size = UDim2.fromOffset(fs, fs),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.3,
	}, holder)
	corner(back, r)
	stroke(back, 0.75)
	local backGrad = new("UIGradient", { Rotation = 55 }, back)
	local setBack = gradientSetter(backGrad)

	local front = frame({ Size = UDim2.fromOffset(fs, fs), BackgroundColor3 = C.white }, holder)
	corner(front, r)
	local frontGrad = new("UIGradient", { Rotation = 55 }, front)
	local setFront = gradientSetter(frontGrad)
	local rim = stroke(front, 0, C.white, 1)
	new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 0.85),
		}),
	}, rim)

	Theme.bind(function(v, instant)
		local d = instant and 0 or 0.35
		setFront(lighten(v.accent, 0.18), darken(v.accent, 0.3), d)
		setBack(darken(v.accent, 0.45), darken(v.accent, 0.72), d)
	end)
	buildIcon("k", fs * 0.66, front, C.dark, math.max(2.6, fs * 0.105))
	return holder, sc
end

