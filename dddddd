		check.holder.Visible = false
		Theme.bind(function(v)
			check.SetColor(v.accent, 0)
		end)
		hoverable(b, hl, 1, 0.94, 0.88)
		items[name] = { text = txt, check = check }
		b.MouseButton1Click:Connect(function()
			selected = name
			renderSelected()
			if o.callback then
				o.callback(name)
			end
		end)
	end
	renderSelected()

	local function setOpen(v)
		isOpen = v
		tween(r, 0.38, { Size = UDim2.new(1, 0, 0, v and full or 52) })
		tween(chev.holder, 0.38, { Rotation = v and 180 or 0 }, Enum.EasingStyle.Back)
	end
	header.MouseButton1Click:Connect(function()
		setOpen(not isOpen)
	end)

	local api = { Row = r }
	function api.Get()
		return selected
	end
	function api.Set(name, silent)
		selected = name
		renderSelected()
		if not silent and o.callback then
			o.callback(name)
		end
	end
	return api
end

-- ------------------------------------------------------------- segmented
function COMP.Segmented(g, o)
	local opts = o.options
	local n = #opts
	local r = newRow(g, 84)
	rowLabel(r, o.text, nil, 0.6, 40)

	local selected = o.default
	if selected == nil then
		selected = opts[1]
	elseif selected == false then
		selected = nil
	end
	local indAlpha = 0.84

	local barF = frame({
		Position = UDim2.new(0, 16, 0, 40),
		Size = UDim2.new(1, -32, 0, 34),
		BackgroundColor3 = C.black,
		BackgroundTransparency = 0.62,
	}, r)
	corner(barF, 17)
	stroke(barF, 0.92)
	local ind = frame({
		Position = UDim2.new(0, 3, 0, 3),
		Size = UDim2.new(1 / n, -6, 1, -6),
		BackgroundColor3 = C.white,
		BackgroundTransparency = selected and indAlpha or 1,
		ZIndex = 2,
	}, barF)
	corner(ind, 14)
	local indStroke = stroke(ind, selected and 0.8 or 1)
	Theme.bind(function(v, instant)
		local d = instant and 0 or 0.3
		indAlpha = luma(v.accent) > 0.8 and 0.84 or 0.78
		setProps(ind, d, { BackgroundColor3 = v.accent })
		setProps(indStroke, d, { Color = v.accent })
		if selected then
			setProps(ind, d, { BackgroundTransparency = indAlpha })
		end
	end)

	local buttons = {}
	local function render(animate)
		for i, name in ipairs(opts) do
			if name == selected then
				setProps(ind, animate and 0.4 or 0, { Position = UDim2.new((i - 1) / n, 3, 0, 3) })
			end
			if buttons[name] then
				tween(buttons[name], 0.2, { TextColor3 = name == selected and C.white or C.sub })
			end
		end
		tween(ind, 0.25, { BackgroundTransparency = selected and indAlpha or 1 })
		tween(indStroke, 0.25, { Transparency = selected and 0.8 or 1 })
	end
	for i, name in ipairs(opts) do
		local b = new("TextButton", {
			Text = name,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new((i - 1) / n, 0, 0, 0),
			Size = UDim2.new(1 / n, 0, 1, 0),
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = name == selected and C.white or C.sub,
			ZIndex = 3,
		}, barF)
		buttons[name] = b
		b.MouseButton1Click:Connect(function()
			selected = name
			render(true)
			if o.callback then
				o.callback(name)
			end
		end)
	end
	render(false)

	local api = { Row = r }
	function api.Get()
		return selected
	end
	function api.Set(name, silent)
		selected = name
		render(true)
		if not silent and o.callback then
			o.callback(name)
		end
	end
	function api.Clear()
		selected = nil
		render(true)
	end
	return api
end

