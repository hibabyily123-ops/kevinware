-- ---------------------------------------------------------------- slider
function COMP.Slider(g, o)
	local min, max, step = o.min, o.max, o.step or 1
	local r = newRow(g, 64)
	rowLabel(r, o.text, nil, 0.6, 38)
	local valueLabel = label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 10),
		Size = UDim2.fromOffset(110, 18),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.sub,
		TextSize = 13,
	}, r)
	valueLabel.Position = UDim2.new(1, -16, 0, 10)

	local hit = new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 16, 0, 34),
		Size = UDim2.new(1, -32, 0, 22),
		ZIndex = 2,
	}, r)
	local track = frame({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.84,
	}, hit)
	corner(track, 2)
	local fill = frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.white }, track)
	corner(fill, 2)
	local knob = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = C.white,
		ZIndex = 3,
	}, track)
	corner(knob, 7)
	stroke(knob, 0.7, C.black, 1)

	local fmt = o.format
		or function(v)
			if step >= 1 then
				return tostring(math.floor(v + 0.5)) .. (o.suffix or "")
			end
			return string.format("%.2f", v) .. (o.suffix or "")
		end
	local value = math.clamp(o.default or min, min, max)

	local function render(animate)
		local f = (value - min) / (max - min)
		local d = animate and 0.2 or 0
		setProps(fill, d, { Size = UDim2.fromScale(f, 1) })
		setProps(knob, d, { Position = UDim2.fromScale(f, 0.5) })
		valueLabel.Text = fmt(value)
	end
	Theme.bind(function(v, instant)
		setProps(fill, instant and 0 or 0.3, { BackgroundColor3 = v.accent })
	end)
	render(false)

	local function fromX(x)
		local ap, as = track.AbsolutePosition.X, track.AbsoluteSize.X
		local f = math.clamp((x - ap) / math.max(as, 1), 0, 1)
		local v = min + f * (max - min)
		v = math.floor((v - min) / step + 0.5) * step + min
		v = tonumber(string.format("%.4f", math.clamp(v, min, max)))
		if v ~= value then
			value = v
			render(false)
			if o.callback then
				o.callback(value)
			end
		end
	end
	dragArea(hit, fromX, function()
		tween(knob, 0.12, { Size = UDim2.fromOffset(18, 18) })
	end, function()
		tween(knob, 0.25, { Size = UDim2.fromOffset(14, 14) }, Enum.EasingStyle.Back)
	end)

	local api = { Row = r }
	function api.Get()
		return value
	end
	function api.Set(v, silent)
		value = math.clamp(v, min, max)
		render(true)
		if not silent and o.callback then
			o.callback(value)
		end
	end
	return api
end

