--========================================================================
-- MOVEMENT  (Sang Z tap launch + Diamond click boost, from Taco Shop v5)
--========================================================================
local Move = {
	sang = { on = false, key = Enum.KeyCode.Z, toggleKey = Enum.KeyCode.V, min = 600, max = 800, lift = 0.2, cooldown = 8.5, duration = 0.5, style = true, last = 0 },
	diamond = { on = false, toggleKey = Enum.KeyCode.B, power = 350, cooldown = 3.5, duration = 0.5, style = true, last = 0 },
}

do
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local active

	local function typing()
		return UserInputService:GetFocusedTextBox() ~= nil
	end

	-- style detection: equipped tool name, attributes, or style text in the game UI
	local function hasStyle(word, uiWord)
		local char = LocalPlayer.Character
		if not char then
			return false
		end
		local function check(inst)
			if string.find(string.lower(inst.Name), word, 1, true) then
				return true
			end
			for _, v in pairs(inst:GetAttributes()) do
				if type(v) == "string" and string.find(string.lower(v), word, 1, true) then
					return true
				end
			end
			return false
		end
		local tool = char:FindFirstChildOfClass("Tool")
		if (tool and check(tool)) or check(char) then
			return true
		end
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if pg then
			for _, d in ipairs(pg:GetDescendants()) do
				if d:IsA("TextLabel") and d.Visible and string.find(string.lower(d.Text), uiWord, 1, true) then
					return true
				end
			end
		end
		return false
	end

	local function lookDir(lift)
		local cam = Workspace.CurrentCamera
		if not cam then
			return nil
		end
		return (cam.CFrame.LookVector + Vector3.new(0, lift, 0)).Unit
	end

	-- velocity launch: full speed, brake over the last 30%, 10% carried out, stops at walls
	local function launch(dir, power, duration)
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not (root and hum and hum.Health > 0) then
			return false
		end
		if active then
			active.conn:Disconnect()
			active = nil
		end
		params.FilterDescendantsInstances = { char }
		local t0 = os.clock()
		local me = {}
		local function stop()
			me.conn:Disconnect()
			if active == me then
				active = nil
			end
		end
		me.conn = RunService.Heartbeat:Connect(function(dt)
			local t = (os.clock() - t0) / duration
			local blocked = hum.Health <= 0
				or hum.Sit
				or char:GetAttribute("Ragdoll") == true
				or hum:GetState() == Enum.HumanoidStateType.Ragdoll
			if blocked or not root.Parent then
				stop()
				return
			end
			if t >= 1 then
				root.AssemblyLinearVelocity = dir * power * 0.1
				stop()
				return
			end
			local speed = power
			if t > 0.7 then
				speed = power * (1 - 0.9 * ((t - 0.7) / 0.3))
			end
			local hit = Workspace:Blockcast(CFrame.new(root.Position), Vector3.new(2, 4, 2), dir * (speed * dt + 2), params)
			if hit then
				root.AssemblyLinearVelocity = Vector3.zero
				stop()
				return
			end
			root.AssemblyLinearVelocity = dir * speed
		end)
		active = me
		return true
	end
	onUnload(function()
		if active then
			active.conn:Disconnect()
			active = nil
		end
	end)

	function Move.sangFire()
		local s = Move.sang
		if not s.on or os.clock() - s.last < s.cooldown then
			return
		end
		if s.style and not hasStyle("sanguine", "bloodbane") then
			return
		end
		local lo, hi = math.min(s.min, s.max), math.max(s.min, s.max)
		local dir = lookDir(s.lift)
		if dir and launch(dir, lo + math.random() * (hi - lo), s.duration) then
			s.last = os.clock()
		end
	end

	function Move.diamondFire()
		local d = Move.diamond
		if not d.on or os.clock() - d.last < d.cooldown then
			return
		end
		if d.style and not hasStyle("diamond", "diamond") then
			return
		end
		local dir = lookDir(0)
		if dir and launch(dir, d.power, d.duration) then
			d.last = os.clock()
		end
	end

	bindConn(UserInputService.InputBegan, function(input, gp)
		if typing() then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.Keyboard then
			if input.KeyCode == Move.sang.key then
				Move.sangFire()
			end
			if input.KeyCode == Move.sang.toggleKey and Move.sangToggle then
				Move.sangToggle.Set(not Move.sangToggle.Get())
			end
			if input.KeyCode == Move.diamond.toggleKey and Move.diamondToggle then
				Move.diamondToggle.Set(not Move.diamondToggle.Get())
			end
		elseif t == Enum.UserInputType.MouseButton1 and not gp then
			Move.diamondFire()
		end
	end)
end

