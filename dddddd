--========================================================================
local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

-- tween when dur > 0, otherwise assign directly
local function setProps(obj, dur, props, style, dir)
	if dur and dur > 0 then
		return tween(obj, dur, props, style, dir)
	end
	for k, v in pairs(props) do
		obj[k] = v
	end
	return nil
end

local function new(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function frame(props, parent)
	props.BorderSizePixel = 0
	return new("Frame", props, parent)
end

local function corner(obj, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) }, obj)
end

local function stroke(obj, transparency, color, thickness)
	return new("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color or C.white,
		Transparency = transparency,
		Thickness = thickness or 1,
	}, obj)
end

-- 1px rim that is bright on top and fades toward the bottom
local function glassStroke(obj)
	local st = stroke(obj, 0, C.white, 1)
	new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(0.5, 0.9),
			NumberSequenceKeypoint.new(1, 0.8),
		}),
	}, st)
	return st
end

local function label(props, parent)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.Font = props.Font or Enum.Font.GothamMedium
	props.TextColor3 = props.TextColor3 or C.white
	props.TextSize = props.TextSize or M.FontSize
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return new("TextLabel", props, parent)
end

local function hoverable(btn, target, base, over, down)
	local hovering = false
	btn.MouseEnter:Connect(function()
		hovering = true
		tween(target, 0.15, { BackgroundTransparency = over })
	end)
	btn.MouseLeave:Connect(function()
		hovering = false
		tween(target, 0.2, { BackgroundTransparency = base })
	end)
	btn.MouseButton1Down:Connect(function()
		tween(target, 0.08, { BackgroundTransparency = down })
	end)
	btn.MouseButton1Up:Connect(function()
		tween(target, 0.15, { BackgroundTransparency = hovering and over or base })
	end)
end

local function makeShadow(parent, radius, startHidden)
	local layers = {}
	for i = 1, #SHADOW_T do
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 3 + i * 2),
			Size = UDim2.new(1, i * 10, 1, i * 10),
			BackgroundColor3 = C.black,
			BackgroundTransparency = startHidden and 1 or SHADOW_T[i],
			ZIndex = 0,
		}, parent)
		corner(f, radius + i * 5)
		layers[i] = f
	end
	return layers
end

local function textWidth(text, size, font)
	local ok, v = pcall(function()
		return TextService:GetTextSize(text, size or M.FontSize, font or Enum.Font.GothamMedium, Vector2.new(1000, 100))
	end)
	if ok and v then
		return math.ceil(v.X)
	end
	return math.ceil(#text * (size or M.FontSize) * 0.6)
end

local orderCount = setmetatable({}, { __mode = "k" })
local function nextOrder(p)
	local n = (orderCount[p] or 0) + 1
	orderCount[p] = n
	return n
end

local function luma(c)
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

local function lighten(c, t)
	return c:Lerp(C.white, t)
end

local function darken(c, t)
	return c:Lerp(C.black, t)
end

local function inputPos(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		return Vector2.new(input.Position.X, input.Position.Y)
	end
	return UserInputService:GetMouseLocation()
end

local function isPress(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

-- press + drag on `hit`; calls onDrag(x, y) in screen pixels
local function dragArea(hit, onDrag, onBegin, onEnd)
	hit.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end
		local p = inputPos(input)
		if onBegin then
			onBegin()
		end
		onDrag(p.X, p.Y)
		local moveConn, endConn
		moveConn = UserInputService.InputChanged:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
				local q = inputPos(i)
				onDrag(q.X, q.Y)
			end
		end)
		endConn = UserInputService.InputEnded:Connect(function(i)
			if isPress(i) then
				moveConn:Disconnect()
				endConn:Disconnect()
				if onEnd then
					onEnd()
				end
			end
		end)
	end)
end

-- returns a function that tweens a 2-colour gradient
local function gradientSetter(grad)
	local a, b = Instance.new("Color3Value"), Instance.new("Color3Value")
	local function upd()
		grad.Color = ColorSequence.new(a.Value, b.Value)
	end
	a.Changed:Connect(upd)
	b.Changed:Connect(upd)
	return function(c1, c2, dur)
		if dur and dur > 0 then
			tween(a, dur, { Value = c1 })
			tween(b, dur, { Value = c2 })
		else
			a.Value = c1
			b.Value = c2
		end
	end
end

