--========================================================================
-- CONFIG WIRING: any component created with `key = "..."` is saved/exported
--========================================================================
local function wrapComponent(name, make)
	local orig = COMP[name]
	COMP[name] = function(g, o)
		local cb = o.callback
		if o.key then
			o.callback = function(...)
				if cb then
					cb(...)
				end
				Cfg.dirty()
			end
		end
		local api = orig(g, o)
		if o.key then
			local get, set = make(o, api)
			Cfg.add(o.key, get, set, { noReset = o.noReset, skip = o.skip, noExport = o.noConfig })
		end
		return api
	end
end

wrapComponent("Toggle", function(o, api)
	return api.Get, function(v)
		api.Set(v == true)
	end
end)
wrapComponent("Slider", function(o, api)
	return api.Get, function(v)
		if type(v) == "number" then
			api.Set(v)
		end
	end
end)
wrapComponent("Dropdown", function(o, api)
	return api.Get, function(v)
		if table.find(o.options, v) then
			api.Set(v)
		end
	end
end)
wrapComponent("Segmented", function(o, api)
	return api.Get, function(v)
		if table.find(o.options, v) then
			api.Set(v)
		end
	end
end)
wrapComponent("Swatches", function(o, api)
	return api.Get, function(v)
		if v ~= "Custom" then
			api.Set(v)
		end
	end
end)
wrapComponent("ColorPicker", function(o, api)
	return function()
		return toHex(api.Get())
	end, function(h)
		local c = fromHex(h)
		if c then
			api.Set(c)
		end
	end
end)
wrapComponent("Keybind", function(o, api)
	return function()
		return api.Get().Name
	end, function(n)
		local k = Enum.KeyCode[n]
		if k then
			api.Set(k)
		end
	end
end)

