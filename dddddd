-- SNOW
--========================================================================
Snow.enabled = false
Snow.amount = 0.5
Snow.speed = 1
Snow.max = 150
Snow.particles = {}

function Snow.build(n)
	while #Snow.particles < n do
		local size = math.random(2, 6)
		local f = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = C.white,
			BackgroundTransparency = 0.1 + math.random() * 0.45,
			Visible = false,
		}, snowLayer)
		corner(f, 99)
		table.insert(Snow.particles, {
			f = f,
			x = math.random(),
			y = math.random(),
			sp = 0.035 + size * 0.012 + math.random() * 0.03,
			ph = math.random() * 6.28,
		})
	end
end

function Snow.step(dt)
	local count = math.floor(Snow.max * Snow.amount + 0.5)
	local t = os.clock()
	for i, p in ipairs(Snow.particles) do
		if i <= count then
			p.f.Visible = true
			p.y += p.sp * dt * Snow.speed
			if p.y > 1.03 then
				p.y = -0.03
				p.x = math.random()
			end
			p.f.Position = UDim2.fromScale(p.x + math.sin(t * 0.8 + p.ph) * 0.012, p.y)
		else
			p.f.Visible = false
		end
	end
end

function Snow.refresh()
	local want = Snow.enabled and state.shown and not unloaded
	if want and not Snow.conn then
		Snow.build(math.floor(Snow.max * Snow.amount + 0.5))
		snowLayer.Visible = true
		Snow.conn = RunService.RenderStepped:Connect(Snow.step)
	elseif not want and Snow.conn then
		Snow.conn:Disconnect()
		Snow.conn = nil
		snowLayer.Visible = false
	end
end
onUnload(function()
	if Snow.conn then
		Snow.conn:Disconnect()
		Snow.conn = nil
	end
end)

--========================================================================
-- PERFORMANCE
--========================================================================
local Perf = { orig = {}, fps = { uncap = false, limit = 60 }, worldState = {} }

local function fpsSetter()
	if type(setfpscap) == "function" then
		return setfpscap
	end
	if type(set_fps_cap) == "function" then
		return set_fps_cap
	end
	if syn and type(syn.set_fps_cap) == "function" then
		return syn.set_fps_cap
	end
	return nil
end

-- returns the method that worked ("setfpscap" / "fflag") or nil
function Perf.applyFps()
	if Perf.origFps == nil then
		local ok, v = false, nil
		if type(getfpscap) == "function" then
			ok, v = pcall(getfpscap)
		end
		Perf.origFps = (ok and type(v) == "number" and v > 0) and v or 60
	end
	local target = Perf.fps.uncap and 1000 or Perf.fps.limit
	local fn = fpsSetter()
	if fn and pcall(fn, target) then
		return "setfpscap"
	end
	if type(setfflag) == "function" then
		local a = pcall(setfflag, "TaskSchedulerTargetFps", tostring(target))
		local b = pcall(setfflag, "DFIntTaskSchedulerTargetFps", tostring(target))
		if a or b then
			return "fflag"
		end
	end
	return nil
end

-- average rendered FPS over `sec` seconds
function Perf.measure(sec)
	local frames, t = 0, 0
	local conn = RunService.RenderStepped:Connect(function(dt)
		frames += 1
		t += dt
	end)
	task.wait(sec)
	conn:Disconnect()
	return t > 0 and math.floor(frames / t + 0.5) or 0
end

-- Roblox / games sometimes reset the cap, so keep re-applying while uncapped
do
	local acc = 0
	bindConn(RunService.Heartbeat, function(dt)
		if not Perf.fps.uncap then
			return
		end
		acc += dt
		if acc >= 4 then
			acc = 0
			Perf.applyFps()
		end
	end)
end

function Perf.quality(level)
	pcall(function()
		local r = settings().Rendering
		if Perf.origQuality == nil then
			Perf.origQuality = r.QualityLevel
		end
		r.QualityLevel = level
	end)
end

function Perf.shadows(off)
	if off then
		if Perf.orig.shadows == nil then
			Perf.orig.shadows = Lighting.GlobalShadows
		end
		Lighting.GlobalShadows = false
	elseif Perf.orig.shadows ~= nil then
		Lighting.GlobalShadows = Perf.orig.shadows
		Perf.orig.shadows = nil
	end
end

local EFFECTS = {
	BlurEffect = true,
	BloomEffect = true,
	SunRaysEffect = true,
	ColorCorrectionEffect = true,
	DepthOfFieldEffect = true,
}
function Perf.postfx(off)
	if off then
		Perf.fxOrig = Perf.fxOrig or {}
		local function scan(parent)
			for _, e in ipairs(parent:GetChildren()) do
				if EFFECTS[e.ClassName] and e.Name ~= "KevinwareBlur" then
					if Perf.fxOrig[e] == nil then
						Perf.fxOrig[e] = e.Enabled
					end
					e.Enabled = false
				end
			end
		end
		scan(Lighting)
		if Workspace.CurrentCamera then
			scan(Workspace.CurrentCamera)
		end
	elseif Perf.fxOrig then
		for e, en in pairs(Perf.fxOrig) do
			if e.Parent then
				e.Enabled = en
			end
		end
		Perf.fxOrig = nil
	end
end

local PARTICLES = { ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true, Sparkles = true }
local WORLD = {
	smooth = {
		test = function(d)
			return d:IsA("BasePart") and not d:IsA("Terrain")
		end,
		apply = function(d)
			local o = d.Material
			d.Material = Enum.Material.SmoothPlastic
			return o
		end,
		restore = function(d, o)
			d.Material = o
		end,
	},
	textures = {
		test = function(d)
			return d:IsA("Decal") or d:IsA("Texture")
		end,
		apply = function(d)
			local o = d.Transparency
			d.Transparency = 1
			return o
		end,
		restore = function(d, o)
			d.Transparency = o
		end,
	},
	particles = {
		test = function(d)
			return PARTICLES[d.ClassName] == true
		end,
		apply = function(d)
			local o = d.Enabled
			d.Enabled = false
			return o
		end,
		restore = function(d, o)
			d.Enabled = o
		end,
	},
}
for name in pairs(WORLD) do
	Perf.worldState[name] = { on = false, store = setmetatable({}, { __mode = "k" }) }
end

function Perf.world(name, on)
	local f, st = WORLD[name], Perf.worldState[name]
	if on == st.on then
		return
	end
	st.on = on
	if st.token then
		st.token.cancel = true
	end
	if st.conn then
		st.conn:Disconnect()
		st.conn = nil
	end
	local token = { cancel = false }
	st.token = token
	local function handle(d)
		pcall(function()
			if f.test(d) and st.store[d] == nil then
				st.store[d] = f.apply(d)
			end
		end)
	end
	if on then
		st.conn = Workspace.DescendantAdded:Connect(handle)
		task.spawn(function()
			local list = Workspace:GetDescendants()
			for i, d in ipairs(list) do
				if token.cancel then
					return
				end
				handle(d)
				if i % 500 == 0 then
					task.wait()
				end
			end
		end)
	else
		task.spawn(function()
			local n = 0
			for d, o in pairs(st.store) do
				if token.cancel then
					return
				end
				pcall(function()
					if d.Parent then
						f.restore(d, o)
					end
				end)
				st.store[d] = nil
				n += 1
				if n % 500 == 0 then
					task.wait()
				end
			end
		end)
	end
end

function Perf.terrain(on)
	local t = Workspace:FindFirstChildOfClass("Terrain")
	if not t then
		return
	end
	if on then
		if not Perf.terrainOrig then
			local o = {}
			pcall(function()
				o.WaterReflectance = t.WaterReflectance
				o.WaterWaveSize = t.WaterWaveSize
				o.WaterWaveSpeed = t.WaterWaveSpeed
			end)
			pcall(function()
				o.Decoration = t.Decoration
			end)
			Perf.terrainOrig = o
		end
		pcall(function()
			t.WaterReflectance = 0
			t.WaterWaveSize = 0
			t.WaterWaveSpeed = 0
		end)
		if type(sethiddenproperty) == "function" then
			pcall(sethiddenproperty, t, "Decoration", false)
		else
			pcall(function()
				t.Decoration = false
			end)
		end
	elseif Perf.terrainOrig then
		local o = Perf.terrainOrig
		Perf.terrainOrig = nil
		pcall(function()
			t.WaterReflectance = o.WaterReflectance
			t.WaterWaveSize = o.WaterWaveSize
			t.WaterWaveSpeed = o.WaterWaveSpeed
		end)
		if o.Decoration ~= nil then
			if type(sethiddenproperty) == "function" then
				pcall(sethiddenproperty, t, "Decoration", o.Decoration)
			else
				pcall(function()
					t.Decoration = o.Decoration
				end)
			end
		end
	end
end

function Perf.render3d(off)
	pcall(function()
		RunService:Set3dRenderingEnabled(not off)
	end)
	Perf.render3dOff = off
end

function Perf.clearMemory()
	local before = Stats:GetTotalMemoryUsageMb()
	pcall(collectgarbage, "collect")
	task.wait(0.25)
	return before, Stats:GetTotalMemoryUsageMb()
end

function Perf.restoreAll()
	for name in pairs(WORLD) do
		Perf.world(name, false)
	end
	Perf.shadows(false)
	Perf.postfx(false)
	Perf.terrain(false)
	if Perf.render3dOff then
		Perf.render3d(false)
	end
	if Perf.origQuality ~= nil then
		pcall(function()
			settings().Rendering.QualityLevel = Perf.origQuality
		end)
	end
	local fpsFn = fpsSetter()
	if Perf.origFps and fpsFn then
		pcall(fpsFn, Perf.origFps)
	end
end
onUnload(Perf.restoreAll)

