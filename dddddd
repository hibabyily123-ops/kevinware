local function capture(inst, props)
	local o = {}
	for _, p in ipairs(props) do
		pcall(function()
			o[p] = inst[p]
		end)
	end
	return o
end

local function restoreProps(inst, o)
	for p, v in pairs(o) do
		pcall(function()
			inst[p] = v
		end)
	end
end

local function pushProps(inst, props)
	for p, v in pairs(props) do
		if inst[p] ~= v then
			pcall(function()
				inst[p] = v
			end)
		end
	end
end

local function eachChild(parent, class, fn)
	for _, c in ipairs(parent:GetChildren()) do
		if c:IsA(class) then
			fn(c)
		end
	end
end

Env.skyStore = setmetatable({}, { __mode = "k" })
Env.atmosStore = setmetatable({}, { __mode = "k" })
Env.gradeStore = setmetatable({}, { __mode = "k" })

function Env.set(props, dur)
	Env.touched = true
	for p, v in pairs(props) do
		Env.desired[p] = v
	end
	if dur and dur > 0 then
		Env.busy += 1
		local tw = TweenService:Create(Lighting, TweenInfo.new(dur, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
		tw.Completed:Connect(function()
			Env.busy -= 1
		end)
		tw:Play()
	else
		for p, v in pairs(props) do
			pcall(function()
				Lighting[p] = v
			end)
		end
	end
end

-- ---- sky / atmosphere: the game's own are moved out of Lighting so ours is the only one,
-- and everything is re-enforced every frame AFTER all game scripts have run
Env.quarantined = {}
Env.origParent = setmetatable({}, { __mode = "k" })

local function quarantine(inst)
	if not Env.quarantined[inst] then
		Env.quarantined[inst] = true
		Env.origParent[inst] = inst.Parent
	end
	if inst.Parent ~= nil then
		pcall(function()
			inst.Parent = nil
		end)
	end
end

function Env.release(class)
	for inst in pairs(Env.quarantined) do
		if inst:IsA(class) then
			Env.quarantined[inst] = nil
			local p = Env.origParent[inst]
			Env.origParent[inst] = nil
			pcall(function()
				inst.Parent = (p and p.Parent) and p or Lighting
			end)
		end
	end
end

local function ensureOwn(kind)
	local key = kind == "Sky" and "ownSky" or "ownAtmos"
	local inst = Env[key]
	if inst and inst.Parent == Lighting then
		return inst
	end
	if inst then
		inst:Destroy()
	end
	inst = Instance.new(kind)
	inst.Name = "Kevinware" .. kind
	inst.Parent = Lighting
	Env[key] = inst
	return inst
end

local function dropOwn(kind)
	local key = kind == "Sky" and "ownSky" or "ownAtmos"
	if Env[key] then
		Env[key]:Destroy()
		Env[key] = nil
	end
end

-- ---- huge non-solid "dome" meshes some games use as a fake sky
Env.domeStore = setmetatable({}, { __mode = "k" })
local DOME_NAMES = { "sky", "dome", "galaxy", "space", "heaven" }

local function isDome(d)
	if not d:IsA("BasePart") or d:IsA("Terrain") then
		return false
	end
	if d.CanCollide or d.Transparency >= 0.95 then
		return false
	end
	local s = d.Size
	local m = math.max(s.X, s.Y, s.Z)
	if m >= 1500 then
		return true
	end
	if m >= 250 then
		local n = string.lower(d.Name)
		for _, w in ipairs(DOME_NAMES) do
			if string.find(n, w, 1, true) then
				return true
			end
		end
	end
	return false
end

local function hideDome(d)
	if Env.domeStore[d] then
		return
	end
	local rec = { mod = d.LocalTransparencyModifier, kids = {} }
	d.LocalTransparencyModifier = 1
	for _, k in ipairs(d:GetChildren()) do
		if k:IsA("Decal") or k:IsA("Texture") then
			rec.kids[k] = k.Transparency
			k.Transparency = 1
		elseif k:IsA("SurfaceGui") then
			rec.kids[k] = k.Enabled
			k.Enabled = false
		end
	end
	Env.domeStore[d] = rec
end

function Env.domes(on)
	if on == Env.domeOn then
		return
	end
	Env.domeOn = on
	if Env.domeToken then
		Env.domeToken.cancel = true
	end
	if Env.domeConn then
		Env.domeConn:Disconnect()
		Env.domeConn = nil
	end
	local token = { cancel = false }
	Env.domeToken = token
	if on then
		Env.domeConn = Workspace.DescendantAdded:Connect(function(d)
			task.defer(function()
				if Env.domeOn and d.Parent and isDome(d) then
					pcall(hideDome, d)
				end
			end)
		end)
		task.spawn(function()
			local list = Workspace:GetDescendants()
			for i, d in ipairs(list) do
				if token.cancel then
					return
				end
				if isDome(d) then
					pcall(hideDome, d)
				end
				if i % 400 == 0 then
					task.wait()
				end
			end
		end)
	else
		for d, rec in pairs(Env.domeStore) do
			pcall(function()
				d.LocalTransparencyModifier = rec.mod
				for k, v in pairs(rec.kids) do
					if k:IsA("SurfaceGui") then
						k.Enabled = v
					else
						k.Transparency = v
					end
				end
			end)
			Env.domeStore[d] = nil
		end
	end
end

function Env.refreshDomes()
	Env.domes((Env.override and Env.touched and Env.hideDomes and not unloaded) == true)
end

function Env.syncAll()
	Env.refreshDomes()
	Env.ensureFx()
	local skyOn = Env.skyFaces ~= nil or Env.skyProps ~= nil
	local atmOn = Env.atmosProps ~= nil
	local gradeOn = Env.override and Env.touched
	if not (skyOn or atmOn or gradeOn or next(Env.gradeStore) ~= nil) then
		return
	end
	local useFaces = Env.skyFaces ~= nil and (Env.skyFacesForce or Env.override)

	local gameSkies, gameAtmos = {}, {}
	local function scan(parent)
		for _, c in ipairs(parent:GetChildren()) do
			local cn = c.ClassName
			if cn == "Sky" then
				if c ~= Env.ownSky then
					table.insert(gameSkies, c)
				end
			elseif cn == "Atmosphere" then
				if c ~= Env.ownAtmos then
					table.insert(gameAtmos, c)
				end
			elseif cn == "ColorCorrectionEffect" and c.Name ~= "KevinwareGrade" then
				if gradeOn then
					if Env.gradeStore[c] == nil then
						Env.gradeStore[c] = c.Enabled
					end
					if c.Enabled then
						c.Enabled = false
					end
				elseif Env.gradeStore[c] ~= nil then
					c.Enabled = Env.gradeStore[c]
					Env.gradeStore[c] = nil
				end
			end
		end
	end
	scan(Lighting)
	if Workspace.CurrentCamera then
		scan(Workspace.CurrentCamera)
	end

	if skyOn then
		if useFaces then
			for _, s in ipairs(gameSkies) do
				quarantine(s)
			end
			local own = ensureOwn("Sky")
			pushProps(own, Env.skyFaces)
			if Env.skyProps then
				pushProps(own, Env.skyProps)
			end
		else
			Env.release("Sky")
			if #gameSkies > 0 then
				dropOwn("Sky")
				for _, s in ipairs(gameSkies) do
					if not Env.skyStore[s] then
						Env.skyStore[s] = capture(s, SKY_PROPS)
					end
					if Env.skyProps then
						pushProps(s, Env.skyProps)
					end
				end
			elseif Env.skyProps then
				pushProps(ensureOwn("Sky"), Env.skyProps)
			end
		end
	end

	if atmOn then
		if Env.override then
			for _, a in ipairs(gameAtmos) do
				quarantine(a)
			end
			pushProps(ensureOwn("Atmosphere"), Env.atmosProps)
		else
			Env.release("Atmosphere")
			if #gameAtmos > 0 then
				dropOwn("Atmosphere")
				for _, a in ipairs(gameAtmos) do
					if not Env.atmosStore[a] then
						Env.atmosStore[a] = capture(a, ATMOS_PROPS)
					end
					pushProps(a, Env.atmosProps)
				end
			else
				pushProps(ensureOwn("Atmosphere"), Env.atmosProps)
			end
		end
	end
end

do
	-- runs after every game RenderStepped script, right before the frame is drawn
	RunService:BindToRenderStep("KevinwareEnv", Enum.RenderPriority.Last.Value + 1, function()
		if not Env.lock then
			return
		end
		if Env.busy <= 0 then
			for p, v in pairs(Env.desired) do
				if Lighting[p] ~= v then
					pcall(function()
						Lighting[p] = v
					end)
				end
			end
		end
		Env.syncAll()
	end)
	onUnload(function()
		pcall(function()
			RunService:UnbindFromRenderStep("KevinwareEnv")
		end)
	end)
	bindConn(Lighting.ChildAdded, function()
		if Env.lock then
			task.defer(Env.syncAll)
		end
	end)
end

function Env.useDefaultSky()
	if not Env.skyFacesForce then
		Env.skyFaces = DEFAULT_FACES
	end
end

function Env.setOverride(on)
	Env.override = on
	Env.syncAll()
end

function Env.resetSky()
	Env.skyFaces, Env.skyProps, Env.atmosProps, Env.skyFacesForce = nil, nil, nil, false
	Env.fx = nil
	Env.ensureFx()
	Env.release("Sky")
	Env.release("Atmosphere")
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("Sky") and Env.skyStore[c] then
			restoreProps(c, Env.skyStore[c])
			Env.skyStore[c] = nil
		elseif c:IsA("Atmosphere") and Env.atmosStore[c] then
			restoreProps(c, Env.atmosStore[c])
			Env.atmosStore[c] = nil
		end
	end
	dropOwn("Sky")
	dropOwn("Atmosphere")
end

-- our own colour grade / bloom / sun rays (only exist while a sky theme asks for them)
function Env.ensureFx()
	local fx = Env.fx
	if not fx then
		if Env.fxMade then
			for _, n in ipairs({ "KevinwareGrade", "KevinwareBloom", "KevinwareRays" }) do
				local i = Lighting:FindFirstChild(n)
				if i then
					i:Destroy()
				end
			end
			Env.fxMade = false
		end
		return
	end
	Env.fxMade = true
	local function get(class, name)
		local i = Lighting:FindFirstChild(name)
		if not i or i.ClassName ~= class then
			if i then
				i:Destroy()
			end
			i = Instance.new(class)
			i.Name = name
			i.Parent = Lighting
		end
		return i
	end
	pushProps(get("ColorCorrectionEffect", "KevinwareGrade"), {
		TintColor = fx.tint,
		Saturation = fx.sat,
		Contrast = fx.contrast,
		Brightness = fx.bright,
		Enabled = true,
	})
	pushProps(get("BloomEffect", "KevinwareBloom"), {
		Intensity = fx.bloom[1],
		Size = fx.bloom[2],
		Threshold = fx.bloom[3],
		Enabled = true,
	})
	pushProps(get("SunRaysEffect", "KevinwareRays"), {
		Intensity = fx.rays[1],
		Spread = fx.rays[2],
		Enabled = true,
	})
end

function Env.cloudsTheme(c)
	local cl = Env.getClouds(true)
	if cl then
		cl.Enabled = true
		cl.Cover = c.Cover
		cl.Density = c.Density
		cl.Color = c.Color
	end
end

