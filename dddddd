				col = (math.floor(pv.t / 1.5) % 2 == 0) and s.visColor or s.hidColor
			end
			local hp = 0.68 + 0.32 * math.sin(pv.t * 0.9)
			local strokeT = s.textOutline and 0.35 or 1
			local ts = s.textSize

			for _, p in ipairs(parts) do
				if s.chams then
					p.f.BackgroundColor3 = col
					p.f.BackgroundTransparency = s.chamsFill
					p.ol.Enabled = true
					p.ol.Color = col
				else
					p.f.BackgroundColor3 = rgb(62, 64, 70)
					p.f.BackgroundTransparency = 0.05
					p.ol.Enabled = false
				end
			end

			pbox.Visible = s.box and (s.boxStyle == "Box" or s.boxFill)
			if pbox.Visible then
				pbox.Position = UDim2.fromOffset(BX, BY)
				pbox.Size = UDim2.fromOffset(BW, BH)
				pbox.BackgroundColor3 = col
				pbox.BackgroundTransparency = s.boxFill and s.fillOpacity or 1
				pboxStroke.Enabled = s.boxStyle == "Box"
				pboxStroke.Color = col
			end
			local cornerOn = s.box and s.boxStyle == "Corner"
			if cornerOn then
				local len, th = 30, 2
				local specs = {
					{ BX, BY, len, th }, { BX, BY, th, len },
					{ BX + BW - len, BY, len, th }, { BX + BW - th, BY, th, len },
					{ BX, BY + BH - th, len, th }, { BX, BY + BH - len, th, len },
					{ BX + BW - len, BY + BH - th, len, th }, { BX + BW - th, BY + BH - len, th, len },
				}
				for i = 1, 8 do
					corners[i].Position = UDim2.fromOffset(specs[i][1], specs[i][2])
					corners[i].Size = UDim2.fromOffset(specs[i][3], specs[i][4])
					corners[i].BackgroundColor3 = col
				end
			end
			for i = 1, 8 do
				corners[i].Visible = cornerOn
			end

			nameT.Visible = s.name
			if s.name then
				nameT.Text = s.nameType == "Username" and "player_01" or "Player"
				nameT.TextSize = ts
				nameT.TextColor3 = col
				nameT.TextStrokeTransparency = strokeT
				nameT.Position = UDim2.fromOffset(116, BY - ts - 5)
			end
			local ly = BY + BH + 3
			distT.Visible = s.distance
			if s.distance then
				distT.TextSize = ts
				distT.TextColor3 = col
				distT.TextStrokeTransparency = strokeT
				distT.Position = UDim2.fromOffset(116, ly)
				ly += ts + 1
			end
			toolT.Visible = s.tool
			if s.tool then
				toolT.TextSize = ts
				toolT.TextColor3 = C.hover
				toolT.TextStrokeTransparency = strokeT
				toolT.Position = UDim2.fromOffset(116, ly)
			end

			hpBg.Visible = s.health
			hpFill.Visible = s.health
			if s.health then
				hpBg.Position = UDim2.fromOffset(BX - 7, BY - 1)
				hpBg.Size = UDim2.fromOffset(5, BH + 2)
				hpFill.Position = UDim2.fromOffset(BX - 6, BY + BH * (1 - hp))
				hpFill.Size = UDim2.fromOffset(3, BH * hp)
				hpFill.BackgroundColor3 = Color3.fromHSV(hp * 0.33, 1, 1)
			end
			hpT.Visible = s.healthText
			if s.healthText then
				hpT.Text = tostring(math.floor(hp * 100))
				hpT.TextSize = math.max(ts - 2, 8)
				hpT.TextStrokeTransparency = strokeT
				hpT.Position = UDim2.fromOffset(BX - (s.health and 10 or 4), BY + BH * (1 - hp))
			end

			for i, pr in ipairs(SK) do
				if s.skeleton then
					skel[i].BackgroundColor3 = col
					setL(skel[i], pts[pr[1]], pts[pr[2]], 1.5)
				else
					skel[i].Visible = false
				end
			end
			if s.tracers then
				tracer.BackgroundColor3 = col
				local from = Vector2.new(116, SH)
				if s.tracerOrigin == "Center" then
					from = Vector2.new(116, SH / 2)
				elseif s.tracerOrigin == "Top" then
					from = Vector2.new(116, 0)
				elseif s.tracerOrigin == "Mouse" then
					from = Vector2.new(190, SH * 0.7)
				end
				setL(tracer, from, Vector2.new(116, BY + BH), 1.5)
			else
				tracer.Visible = false
			end
			dot.Visible = s.headDot
			if s.headDot then
				dot.Position = UDim2.fromOffset(116, 62)
				dot.Size = UDim2.fromOffset(8, 8)
				dot.BackgroundColor3 = col
			end
			arrow.Visible = s.arrows
			if s.arrows then
				arrow.BackgroundColor3 = col
			end
		end

		pv.holder, pv.card, pv.sc, pv.st, pv.shadows = holder, card, sc, st, shadows
		pv.draw = draw
		closeB.MouseButton1Click:Connect(function()
			pv.close()
		end)
	end

	function pv.show()
		if not pv.holder then
			build()
		end
		if pv.open then
			return
		end
		pv.open = true
		pv.holder.Visible = true
		pv.sc.Scale = 0.9
		tween(pv.card, 0.4, { GroupTransparency = 0 })
		tween(pv.st, 0.4, { Transparency = 0 })
		tween(pv.sc, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
		for i, l in ipairs(pv.shadows) do
			tween(l, 0.4, { BackgroundTransparency = SHADOW_T[i] })
		end
		pv.conn = RunService.RenderStepped:Connect(function(dt)
			pv.draw(dt)
		end)
	end

	function pv.close()
		if not pv.open then
			return
		end
		pv.open = false
		if pv.conn then
			pv.conn:Disconnect()
			pv.conn = nil
		end
		tween(pv.card, 0.25, { GroupTransparency = 1 })
		tween(pv.st, 0.25, { Transparency = 1 })
		tween(pv.sc, 0.25, { Scale = 0.94 })
		for _, l in ipairs(pv.shadows) do
			tween(l, 0.2, { BackgroundTransparency = 1 })
		end
		task.delay(0.28, function()
			if not pv.open then
				pv.holder.Visible = false
			end
		end)
	end
	onUnload(function()
		if pv.conn then
			pv.conn:Disconnect()
		end
	end)
	ESP.preview = pv
end

