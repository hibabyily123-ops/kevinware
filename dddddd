function COMP.Swatches(g, o)
	local r = newRow(g, 94)
	rowLabel(r, o.text, nil, 0.5, 40)
	local nameLabel = label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 11),
		Size = UDim2.fromOffset(120, 18),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.sub,
		TextSize = 13,
	}, r)
