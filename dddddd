function Hud.set(on)
	if on == Hud.on then
		return
	end
	Hud.on = on
	if Hud.conn then
		Hud.conn:Disconnect()
		Hud.conn = nil
	end
	if on then
		hudPill.Visible = true
		tween(hudPill, 0.3, { BackgroundTransparency = 0.4 })
		tween(hudStroke, 0.3, { Transparency = 0.88 })
		tween(hudText, 0.3, { TextTransparency = 0 })
		local frames, acc = 0, 0
		Hud.conn = RunService.RenderStepped:Connect(function(dt)
			frames += 1
			acc += dt
			if acc >= 0.5 then
				local fps = math.floor(frames / acc + 0.5)
				frames, acc = 0, 0
				local ok, ping = pcall(function()
					return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
				end)
				local txt = fps .. " FPS"
				if ok and ping then
					txt = txt .. "  |  " .. math.floor(ping + 0.5) .. " ms"
				end
				hudText.Text = txt
			end
		end)
	else
		tween(hudPill, 0.25, { BackgroundTransparency = 1 })
		tween(hudStroke, 0.25, { Transparency = 1 })
		tween(hudText, 0.25, { TextTransparency = 1 })
		task.delay(0.27, function()
			if not Hud.on then
				hudPill.Visible = false
			end
		end)
	end
end
onUnload(function()
	Hud.set(false)
end)

