local function newRow(g, height)
	local r = new("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(g.box),
	}, g.box)
	local div = frame({
		Position = UDim2.new(0, 16, 1, -1),
		Size = UDim2.new(1, -16, 0, 1),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.92,
		ZIndex = 0,
		Visible = false,
	}, r)
	local prev = g.rows[#g.rows]
	if prev then
		prev.div.Visible = true
	end
	table.insert(g.rows, { frame = r, div = div })
	return r
end

-- fixedH: pin the title to a fixed header height (rows that expand or have stacked controls)
local function rowLabel(r, text, desc, widthScale, fixedH)
	local ws = widthScale or 0.55
	local title = label({
		Text = text,
		Position = desc and UDim2.fromOffset(16, 11) or (fixedH and UDim2.fromOffset(16, (fixedH - 18) / 2)) or UDim2.new(0, 16, 0.5, -9),
		Size = UDim2.new(ws, 0, 0, 18),
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, r)
	local d
	if desc then
		d = label({
			Text = desc,
			Position = UDim2.fromOffset(16, 30),
			Size = UDim2.new(ws, 0, 0, 14),
			TextSize = 12,
			TextColor3 = C.sub,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, r)
	end
	return title, d
end

