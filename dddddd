					if dur[1] == grantDur.Get() then
						secs = dur[2]
					end
				end
				ownerCall("/grant", { userId = uid, username = name, seconds = secs }, "Access granted to " .. name)
			end)
		end,
	})

	task.spawn(function()
		task.wait(1)
		ownerRefresh()
	end)
end

--========================================================================
-- AIM  (camlock, silent aim, FOV, team check, triggerbot)
-- Only runs for approved users (Access.has()).
--========================================================================
local Aim = {
	s = {
		camlock = false,
		silent = false,
		trigger = false,
		teamCheck = true,
		wallCheck = false,
		part = "Head",
		key = "Right Mouse",
		smooth = 5,
		fov = 150,
		showFov = true,
		fovColor = rgb(255, 255, 255),
		prediction = 0,
		hitChance = 100,
		triggerDelay = 60,
		triggerHold = false,
	},
	locked = nil,
	silentPart = nil,
	silentPos = nil,
	trigBusy = false,
}

do
	local s = Aim.s
	local VIM = game:GetService("VirtualInputManager")

	local fovLayer = new("Frame", {
		Name = "AimFov",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
		Visible = false,
	}, gui)
	local fovCircle = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(300, 300),
	}, fovLayer)
	corner(fovCircle, 9999)
	local fovStroke = stroke(fovCircle, 0.3, C.white, 1.5)

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local function isEnemy(plr)
		if plr == LocalPlayer then
			return false
		end
		if s.teamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team then
			return false
		end
		return true
	end

	local function isAlive(char)
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return hum ~= nil and hum.Health > 0 and char:FindFirstChildOfClass("ForceField") == nil
	end

	local function aimPart(char, cam, mouse)
		local p = s.part
		if p == "Head" then
			return char:FindFirstChild("Head")
		elseif p == "Torso" then
			return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
		elseif p == "Root" then
			return char:FindFirstChild("HumanoidRootPart")
		end
		-- "Closest": whichever of head / torso / root is nearest the cursor
		local best, bestD
		for _, n in ipairs({ "Head", "UpperTorso", "Torso", "HumanoidRootPart" }) do
			local part = char:FindFirstChild(n)
			if part then
				local sp = cam:WorldToViewportPoint(part.Position)
				local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
				if not bestD or d < bestD then
					best, bestD = part, d
				end
			end
		end
		return best
	end

	local function lineOfSight(cam, part, char)
		local filter = { char }
		if LocalPlayer.Character then
			filter[2] = LocalPlayer.Character
		end
		rayParams.FilterDescendantsInstances = filter
		local o = cam.CFrame.Position
		return Workspace:Raycast(o, part.Position - o, rayParams) == nil
	end

	local function findTarget(cam)
		local mouse = UserInputService:GetMouseLocation()
		local best, bestD = nil, s.fov
		for _, plr in ipairs(Players:GetPlayers()) do
			local char = plr.Character
			if isEnemy(plr) and isAlive(char) then
				local part = aimPart(char, cam, mouse)
				if part then
					local sp = cam:WorldToViewportPoint(part.Position)
					if sp.Z > 0 then
						local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
						if d < bestD and (not s.wallCheck or lineOfSight(cam, part, char)) then
							best, bestD = part, d
						end
					end
				end
			end
		end
		return best
	end

	local function predicted(part)
		return part.Position + part.AssemblyLinearVelocity * s.prediction
	end

	local MOUSE = {
		["Right Mouse"] = Enum.UserInputType.MouseButton2,
		["Left Mouse"] = Enum.UserInputType.MouseButton1,
		["Middle Mouse"] = Enum.UserInputType.MouseButton3,
	}
	local function keyHeld()
		local k = s.key
		if k == "Always on" then
			return true
		end
		if MOUSE[k] then
			return UserInputService:IsMouseButtonPressed(MOUSE[k])
		end
		local kc = Enum.KeyCode[(k:gsub(" ", ""))]
		return kc ~= nil and UserInputService:IsKeyDown(kc)
	end

	-- ---- silent aim: redirects Mouse.Hit / Mouse.Target and Raycast / FindPartOnRay calls
	local hooked = false
	function Aim.installHooks()
		if hooked then
			return true
		end
		if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
			return false
		end
		local wrap = type(newcclosure) == "function" and newcclosure or function(f)
			return f
		end
		local fromScript = type(checkcaller) == "function" and checkcaller or function()
			return false
		end
		local mouse = LocalPlayer:GetMouse()
		local oldIndex, oldNamecall
		local ok = pcall(function()
			oldIndex = hookmetamethod(
				game,
				"__index",
				wrap(function(self, key)
					if Aim.silentPart and self == mouse and (key == "Hit" or key == "Target") and not fromScript() then
						if math.random(100) <= s.hitChance then
							if key == "Hit" then
								return CFrame.new(Aim.silentPos)
							end
							return Aim.silentPart
						end
					end
					return oldIndex(self, key)
				end)
			)
			oldNamecall = hookmetamethod(
				game,
				"__namecall",
				wrap(function(self, ...)
					if Aim.silentPart and self == Workspace and not fromScript() then
						local method = getnamecallmethod()
						local n = select("#", ...)
						local a = { ... }
						if method == "Raycast" then
							if typeof(a[1]) == "Vector3" and typeof(a[2]) == "Vector3" and math.random(100) <= s.hitChance then
								a[2] = (Aim.silentPos - a[1]).Unit * a[2].Magnitude
								return oldNamecall(self, table.unpack(a, 1, n))
							end
						elseif
							method == "FindPartOnRay"
							or method == "FindPartOnRayWithIgnoreList"
							or method == "FindPartOnRayWithWhitelist"
						then
							local ray = a[1]
							if typeof(ray) == "Ray" and math.random(100) <= s.hitChance then
								a[1] = Ray.new(ray.Origin, (Aim.silentPos - ray.Origin).Unit * ray.Direction.Magnitude)
								return oldNamecall(self, table.unpack(a, 1, n))
							end
						end
					end
					return oldNamecall(self, ...)
				end)
			)
		end)
		hooked = ok
		return ok
	end

	local function click()
		pcall(function()
			if type(mouse1click) == "function" then
				mouse1click()
			else
				local p = UserInputService:GetMouseLocation()
				VIM:SendMouseButtonEvent(p.X, p.Y, 0, true, game, 1)
				task.wait(0.02)
				VIM:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 1)
			end
		end)
	end

	local function step(dt)
		local allowed = Access.has()
		local anyOn = s.camlock or s.silent or s.trigger
		local circle = allowed and s.showFov and anyOn
		fovLayer.Visible = circle
		if circle then
			local m = UserInputService:GetMouseLocation()
			fovCircle.Position = UDim2.fromOffset(m.X, m.Y)
			fovCircle.Size = UDim2.fromOffset(s.fov * 2, s.fov * 2)
			fovStroke.Color = s.fovColor
		end
		local cam = Workspace.CurrentCamera
		if not (allowed and anyOn and cam) then
			Aim.locked, Aim.silentPart = nil, nil
			return
		end

		if s.silent then
			local part = findTarget(cam)
			Aim.silentPart = part
			Aim.silentPos = part and predicted(part) or nil
		else
			Aim.silentPart = nil
		end

		if s.camlock and keyHeld() then
			local t = Aim.locked
			if not (t and t.Parent and isAlive(t.Parent)) then
				t = findTarget(cam)
				Aim.locked = t
			end
			if t then
				local goal = CFrame.lookAt(cam.CFrame.Position, predicted(t))
				local alpha = s.smooth <= 1 and 1 or (1 - (1 - 1 / s.smooth) ^ (dt * 60))
				cam.CFrame = cam.CFrame:Lerp(goal, alpha)
			end
		else
			Aim.locked = nil
		end

		if s.trigger and not Aim.trigBusy and (not s.triggerHold or keyHeld()) then
			local m = UserInputService:GetMouseLocation()
			local ray = cam:ViewportPointToRay(m.X, m.Y)
			rayParams.FilterDescendantsInstances = LocalPlayer.Character and { LocalPlayer.Character } or {}
			local hit = Workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
			local inst = hit and hit.Instance
			local char = inst and inst:FindFirstAncestorOfClass("Model")
			local plr = char and Players:GetPlayerFromCharacter(char)
			if plr and isEnemy(plr) and isAlive(char) then
				Aim.trigBusy = true
				task.delay(s.triggerDelay / 1000, function()
					click()
					task.wait(0.08)
					Aim.trigBusy = false
				end)
			end
		end
	end

	-- after the camera script, so our camera change is the one that gets drawn
	RunService:BindToRenderStep("KevinwareAim", Enum.RenderPriority.Camera.Value + 1, function(dt)
		pcall(step, dt)
	end)
	onUnload(function()
		pcall(function()
			RunService:UnbindFromRenderStep("KevinwareAim")
		end)
		Aim.silentPart = nil
		fovLayer.Visible = false
	end)
end

