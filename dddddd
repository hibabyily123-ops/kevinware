	-- ----------------------------------------------- record + hotkeys
	bindConn(UserInputService.InputBegan, function(input, gp)
		local rec = Macros.recording
		if rec then
			if typing() then
				return
			end
			local kind, k
			local t = input.UserInputType
			if t == Enum.UserInputType.Keyboard then
				kind, k = "key", input.KeyCode.Name
			elseif not gp and (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3) then
				kind, k = "mouse", t.Name
			end
			if kind and k ~= "Unknown" and not Macros.open[k] then
				local now = os.clock()
				local ev = {
					kind = kind,
					k = k,
					delay = Macros.recLast and math.floor((now - Macros.recLast) * 1000 + 0.5) or 0,
					hold = 80,
				}
				Macros.recLast = now
				table.insert(rec.events, ev)
				Macros.open[k] = { ev = ev, t0 = now }
			end
			return
		end
		if typing() or state.listening then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			for _, m in ipairs(Macros.list) do
				if m.hotkey and m.hotkey == input.KeyCode.Name then
					if Macros.playing[m] then
						Macros.stop(m)
					else
						Macros.play(m)
					end
				end
			end
		end
	end)
	bindConn(UserInputService.InputEnded, function(input)
		if not Macros.recording then
			return
		end
		local k = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name or input.UserInputType.Name
		local o = Macros.open[k]
		if o then
			o.ev.hold = math.max(10, math.floor((os.clock() - o.t0) * 1000 + 0.5))
			Macros.open[k] = nil
		end
	end)

	-- ------------------------------------------------------- persistence
	Cfg.add("macros.data", function()
		return HttpService:JSONEncode(Macros.list)
	end, function(str)
		local ok, data = pcall(function()
			return HttpService:JSONDecode(str)
		end)
		if not (ok and type(data) == "table") then
			return
		end
		Macros.list = {}
		for _, m in ipairs(data) do
			if type(m) == "table" and type(m.events) == "table" then
				table.insert(Macros.list, {
					name = tostring(m.name or "Macro"),
					speed = tonumber(m.speed) or 1,
					loops = tonumber(m.loops) or 1,
					gap = tonumber(m.gap) or 0,
					hotkey = type(m.hotkey) == "string" and m.hotkey or nil,
					events = m.events,
				})
			end
		end
		Macros.sel = nil
		refreshList()
		refreshEditor()
		refreshEvents()
	end, { noReset = true })

	layout()
	refreshList()
end

