--========================================================================
-- CUSTOM MACROS  (record key presses, edit delay / hold, speed, repeats, hotkey)
--========================================================================
local Macros = { list = {}, sel = nil, recording = nil, playing = {}, open = {}, recLast = nil }

do
	local HttpService = game:GetService("HttpService")
	local VIM = game:GetService("VirtualInputManager")
	local page = Tabs.Macros.Content
	local editorOpen = false

	local function typing()
		return UserInputService:GetFocusedTextBox() ~= nil
	end
	local function pretty(ev)
		if ev.kind == "mouse" then
			return ({ MouseButton1 = "Left click", MouseButton2 = "Right click", MouseButton3 = "Middle click" })[ev.k]
				or tostring(ev.k)
		end
		return (tostring(ev.k):gsub("(%l)(%u)", "%1 %2"))
	end
	local function press(ev, down)
		pcall(function()
			if ev.kind == "mouse" then
				local btn = ev.k == "MouseButton1" and 0 or (ev.k == "MouseButton2" and 1 or 2)
				local p = UserInputService:GetMouseLocation()
				VIM:SendMouseButtonEvent(p.X, p.Y, btn, down, game, 1)
			else
				local kc = Enum.KeyCode[tostring(ev.k)]
				if kc then
					VIM:SendKeyEvent(down, kc, false, game)
				end
			end
		end)
	end

	local refreshList, refreshEditor, refreshEvents, selectMacro, startRec, stopRec

	-- ---------------------------------------------------------- playback
	function Macros.stop(m)
		local t = Macros.playing[m]
		if t then
			t.cancel = true
		end
	end
	function Macros.play(m)
		if Macros.playing[m] or #m.events == 0 then
			return
		end
		local token = { cancel = false }
		Macros.playing[m] = token
		task.spawn(function()
			local n = 0
			local speed = math.max(tonumber(m.speed) or 1, 0.05)
			while not token.cancel and (m.loops == 0 or n < m.loops) do
				n += 1
				for _, ev in ipairs(m.events) do
					if token.cancel then
						break
					end
					task.wait(math.max(tonumber(ev.delay) or 0, 0) / 1000 / speed)
					if token.cancel then
						break
					end
					task.spawn(function()
						press(ev, true)
						task.wait(math.max(tonumber(ev.hold) or 50, 10) / 1000 / speed)
						press(ev, false)
					end)
				end
				local last = m.events[#m.events]
				if last and not token.cancel then
					task.wait((math.max(tonumber(last.hold) or 50, 10) / 1000 / speed) + 0.02)
				end
				if not token.cancel and (tonumber(m.gap) or 0) > 0 then
					task.wait(m.gap / 1000)
				end
			end
			Macros.playing[m] = nil
			refreshList()
			refreshEditor()
		end)
		refreshList()
		refreshEditor()
	end
	onUnload(function()
		Macros.recording = nil
		for _, t in pairs(Macros.playing) do
			t.cancel = true
		end
	end)

	-- ------------------------------------------------------------- layout
	local mainWraps = {}
	for _, c in ipairs(page:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(mainWraps, c)
		end
	end
	local gEntry = COMP.Group(page, "Custom macros")
	table.insert(mainWraps, gEntry.box.Parent)
	local gBack = COMP.Group(page, nil)
	local gList = COMP.Group(page, "Your macros")
	local gEdit = COMP.Group(page, "Macro editor")
	local gEvents = COMP.Group(page, "Keys")
	local listWraps = { gBack.box.Parent, gList.box.Parent }
	local selWraps = { gEdit.box.Parent, gEvents.box.Parent }

	local function layout()
		for _, w in ipairs(mainWraps) do
			w.Visible = not editorOpen
		end
		for _, w in ipairs(listWraps) do
			w.Visible = editorOpen
		end
		for _, w in ipairs(selWraps) do
			w.Visible = editorOpen and Macros.sel ~= nil
		end
	end
	local function showEditor(on)
		editorOpen = on
		layout()
		page.CanvasPosition = Vector2.new(0, 0)
	end

	COMP.Button(gEntry, {
		text = "Custom macros",
		desc = "Record your own key sequences",
		buttonText = "Open",
		callback = function()
			showEditor(true)
		end,
	})
	COMP.Button(gBack, {
		text = "Back",
		desc = "Return to the other macros",
		buttonText = "Back",
		callback = function()
			showEditor(false)
		end,
	})

	-- ------------------------------------------------------------ editor
	local nameIn = COMP.Input(gEdit, {
		text = "Name",
		placeholder = "macro name",
		buttonText = "Rename",
		callback = function(t)
			local m = Macros.sel
			if m and t ~= "" then
				m.name = t
				Cfg.dirty()
				refreshList()
			end
		end,
	})

	local hkBtn
	do
		local r = newRow(gEdit, 60)
		rowLabel(r, "Hotkey", "Press it to play or stop. Backspace clears", 0.55)
		hkBtn = makeButton(r, "None", "ghost", 130, 32, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -16, 0.5, 0),
		})
		hkBtn.Button.MouseButton1Click:Connect(function()
			local m = Macros.sel
			if not m or state.listening then
				return
			end
			state.listening = true
			hkBtn.SetText("Press a key...")
			local conn
			conn = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then
					return
				end
				conn:Disconnect()
				task.delay(0.1, function()
					state.listening = false
				end)
				if input.KeyCode == Enum.KeyCode.Backspace then
					m.hotkey = nil
				elseif input.KeyCode ~= Enum.KeyCode.Escape then
					m.hotkey = input.KeyCode.Name
				end
				Cfg.dirty()
				refreshEditor()
				refreshList()
			end)
		end)
	end

	local recRow = COMP.Button(gEdit, {
		text = "Record",
		desc = "Press keys in the game, then press Stop",
		buttonText = "Record",
		style = "primary",
		callback = function()
			local m = Macros.sel
			if not m then
				return
			end
			if Macros.recording then
				stopRec()
			else
				startRec(m)
			end
		end,
	})
	local playRow = COMP.Button(gEdit, {
		text = "Play",
		buttonText = "Play",
		style = "primary",
		callback = function()
			local m = Macros.sel
			if not m then
				return
			end
			if Macros.playing[m] then
				Macros.stop(m)
			else
				Macros.play(m)
			end
		end,
	})
	local speedS = COMP.Slider(gEdit, {
		text = "Speed",
		min = 0.25,
		max = 4,
		step = 0.05,
		default = 1,
		suffix = "x",
		callback = function(v)
			if Macros.sel then
				Macros.sel.speed = v
				Cfg.dirty()
			end
		end,
	})
	local loopsS = COMP.Slider(gEdit, {
		text = "Repeat",
		min = 0,
		max = 50,
		step = 1,
		default = 1,
		format = function(v)
			return v < 0.5 and "Forever" or (math.floor(v + 0.5) .. "x")
		end,
		callback = function(v)
			if Macros.sel then
				Macros.sel.loops = v
				Cfg.dirty()
			end
		end,
	})
	local gapS = COMP.Slider(gEdit, {
		text = "Gap between repeats",
		min = 0,
		max = 2000,
		step = 50,
		default = 0,
		suffix = " ms",
		callback = function(v)
			if Macros.sel then
				Macros.sel.gap = v
				Cfg.dirty()
			end
		end,
	})

	function startRec(m)
		m.events = {}
		Macros.recording = m
		Macros.open = {}
		Macros.recLast = nil
		recRow.Button.SetText("Stop")
		recRow.Button.SetStyle("danger")
		toast("Recording", "Press the keys you want, then click Stop.", 3)
		refreshEvents()
	end
	function stopRec()
		local m = Macros.recording
		Macros.recording = nil
		Macros.open = {}
		recRow.Button.SetText("Record")
		recRow.Button.SetStyle("primary")
